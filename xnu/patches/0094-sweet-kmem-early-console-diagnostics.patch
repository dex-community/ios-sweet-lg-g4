diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -125,7 +125,28 @@
 	sweet_early_clean();
 }
 
+/*
+ * Formatted diagnostics for the early boot. kprintf() output does not reach
+ * the persistent console ring this early (and is lost on a watchdog reset),
+ * so the numbers that decide the kmem layout are written straight into the
+ * early buffer and cleaned to DRAM, like the marks and the panic text.
+ */
 void
+sweet_early_logf(const char *fmt, ...)
+{
+	va_list args;
+
+	if (early_disabled || early_panicking) {
+		return;
+	}
+	va_start(args, fmt);
+	_doprnt(fmt, &args, sweet_early_putc, 16);
+	va_end(args);
+	sweet_early_putc('\n');
+	sweet_early_clean();
+}
+
+void
 sweet_early_panic(const char *fmt, va_list *args)
 {
 	if (early_disabled || early_panicking) {
