+++ b/drivers/NativeSdhci/NativeSdhci.h
@@ -0,0 +1,129 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#ifndef NATIVE_SDHCI_H
+#define NATIVE_SDHCI_H
+
+#include <IOKit/IOLib.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <IOKit/storage/IOBlockStorageDevice.h>
+#include "PollingHost.h"
+
+// IOMemoryMap has no header of its own in the kernel tree: IOService.h declares the
+// name for mapDeviceMemoryWithIndex(), and NativeSdhci.cpp includes the descriptor
+// header for the complete class.
+
+class NativeSdhci : public IOBlockStorageDevice {
+    OSDeclareDefaultStructors(NativeSdhci)
+
+public:
+    bool start(IOService *provider) override;
+    void stop(IOService *provider) override;
+    void free() override;
+
+    // IOBlockStorageDevice
+    IOReturn doEjectMedia() override { return kIOReturnUnsupported; }
+    IOReturn doFormatMedia(UInt64) override { return kIOReturnUnsupported; }
+    UInt32   doGetFormatCapacities(UInt64 *, UInt32) const override { return 0; }
+    char    *getVendorString() override { return const_cast<char *>("Native"); }
+    char    *getProductString() override { return const_cast<char *>("Lumia 950 eMMC"); }
+    char    *getRevisionString() override { return const_cast<char *>("0.1"); }
+    char    *getAdditionalDeviceInfoString() override { return const_cast<char *>("writes only inside GPT 'ios', with sdhcirw=1"); }
+    IOReturn reportBlockSize(UInt64 *value) override;
+    IOReturn reportEjectability(bool *value) override;
+    IOReturn reportMaxValidBlock(UInt64 *value) override;
+    IOReturn reportMediaState(bool *present, bool *changed) override;
+    IOReturn reportRemovability(bool *value) override;
+    IOReturn reportWriteProtection(bool *value) override;
+    IOReturn doSynchronizeCache() override { return online ? kIOReturnSuccess : kIOReturnNotReady; }
+    IOReturn doAsyncReadWrite(IOMemoryDescriptor *buffer, UInt64 block, UInt64 count,
+                              IOStorageAttributes *attributes, IOStorageCompletion *completion) override;
+
+private:
+    // Register access. SDHCI mixes 8-, 16- and 32-bit registers, so the width is
+    // explicit rather than derived from a 32-bit read.
+    uint8_t  readHc8(uint32_t offset) const;
+    uint16_t readHc16(uint32_t offset) const;
+    uint32_t readHc32(uint32_t offset) const;
+    void     writeHc8(uint32_t offset, uint8_t value);
+    void     writeHc16(uint32_t offset, uint16_t value);
+    void     writeHc32(uint32_t offset, uint32_t value);
+    uint32_t readCore32(uint32_t offset) const;
+    void     writeCore32(uint32_t offset, uint32_t value);
+    uint32_t readGcc32(uint32_t offset) const;
+    void     writeGcc32(uint32_t offset, uint32_t value);
+
+    bool mapWindows(IOService *provider);
+    void logHost();
+    void logVendor();
+    bool setBusClock(uint32_t hz);
+    bool setBusWidth(uint32_t bits);
+    static bool busClock(void *context, sdhci::u32 hz);
+    static bool busWidth(void *context, sdhci::u32 bits);
+    bool identifyCold();
+    void findWritableWindow();
+    bool readBlocksPio(uint64_t lba, uint32_t count, void *bytes);
+    void setupDma();
+    bool readBlocksDma(uint64_t lba, uint32_t count);
+    void startConsoleLog();
+    bool writeLogBlocks(uint64_t lba, uint32_t count, const uint8_t *bytes);
+    void writeLogHeader();
+
+public:
+    // panicking: called from the panic path with everything else stopped; takes no lock and logs
+    // nothing (native_panic_flush).
+    void flushConsoleLog(bool panicking = false);
+
+private:
+    static void consoleLogThread(void *self, wait_result_t);
+    bool probeCard();
+    void logFailure();
+    static sdhci::u8 ioRead8(void *context, sdhci::u32 offset);
+    static sdhci::u32 ioRead32(void *context, sdhci::u32 offset);
+    static void ioWrite8(void *context, sdhci::u32 offset, sdhci::u8 value);
+    static void ioWrite16(void *context, sdhci::u32 offset, sdhci::u16 value);
+    static void ioWrite32(void *context, sdhci::u32 offset, sdhci::u32 value);
+    static void ioDelay(void *context, sdhci::u32 microseconds);
+
+    IOLock            *gate = nullptr;
+    volatile uint8_t  *hc = nullptr;
+    volatile uint8_t  *core = nullptr;
+    IOMemoryMap       *hcMap = nullptr;
+    IOMemoryMap       *coreMap = nullptr;
+    IOMemoryMap       *gccMap = nullptr;
+    volatile uint8_t  *gcc = nullptr;
+    uint8_t           *bounce = nullptr;   // kMaxTransferBlocks * 512 bytes
+    // ADMA2 reads (setupDma): a physically contiguous kMaxDmaBlocks * 512-byte buffer and a page
+    // for the descriptor table, both below 4 GiB; dma is cleared for good after any DMA failure.
+    IOBufferMemoryDescriptor *dmaBuffer = nullptr;
+    IOBufferMemoryDescriptor *dmaTable = nullptr;
+    uint32_t           dmaBufferPhys = 0;
+    uint32_t           dmaTablePhys = 0;
+    bool               dma = false;
+
+    uint32_t baseClockHz = 0;
+    uint16_t hostVersion = 0;
+    uint16_t relativeAddress = 0;
+    uint64_t capacityBytes = 0;
+    uint64_t blockCount = 0;
+    bool     online = false;
+    bool     writeRefused = false;
+    uint64_t windowFirst = 0;
+    uint64_t windowLast = 0;
+
+    // Console log on the medium (see startConsoleLog). Stream offsets count bytes from the
+    // start of the log ever written; this boot's console ring byte i is at logBootBase + i.
+    uint64_t logHeaderLba = 0;
+    uint64_t logDataLba = 0;
+    uint64_t logBootBase = 0;
+    uint64_t logFlushed = 0;     // console ring bytes already on the medium
+    uint64_t logLost = 0;
+    uint64_t logFlushes = 0;
+    uint32_t logBoot = 0;
+    bool     logging = false;
+    bool     logPanicking = false;
+    uint8_t *logBuffer = nullptr;   // kMaxTransferBlocks * 512 bytes
+    sdhci::PollingHost host;
+    sdhci::WarmCard card;
+};
+
+#endif // NATIVE_SDHCI_H
diff --git a/drivers/NativeSdhci/PollingHost.cpp b/drivers/NativeSdhci/PollingHost.cpp
new file mode 100644
index 0000000..050e6e2
--- /dev/null
+++ b/drivers/NativeSdhci/PollingHost.cpp
@@ -0,0 +1,560 @@
+#include "PollingHost.h"
+#include "SdhciRegs.h"
+
+namespace sdhci {
+namespace {
+constexpr u32 kErrorStatus = 0xffff8000u;
+constexpr u32 kPollingStatus = kIntCommandComplete | kIntTransferComplete |
+                               kIntBufferReadReady | kIntBufferWriteReady | kIntError | 0x03ff0000u;
+constexpr u32 kCardErrors = 0xffff0000u | (1u << 7);
+constexpr u32 kReadyForData = 1u << 8;
+constexpr u32 kStateStandby = 3;
+constexpr u32 kStateTransfer = 4;
+// CMD1 argument: sector addressing, 2.7-3.6 V and 1.70-1.95 V.
+constexpr u32 kOcrRequest = 0x40ff8080u;
+constexpr u32 kOcrReady = 1u << 31;
+constexpr u32 kOcrSectorMode = 1u << 30;
+constexpr u32 kIdentificationHz = 400000;
+constexpr u32 kOperatingConditionPolls = 1000;
+// CMD13 polls (1 ms apart) after a write or a CMD6 switch: programming may take a while.
+constexpr u32 kProgramPolls = 2000;
+constexpr u8 kExtCsdBusWidth = 183;
+constexpr u8 kExtCsdHsTiming = 185;
+
+u32 cardState(u32 response)
+{
+    return (response >> 9) & 15;
+}
+}
+
+bool PollingHost::validIo() const
+{
+    return io.read8 && io.read32 && io.write8 && io.write16 && io.write32 && io.delayUs;
+}
+
+bool PollingHost::configure(const RegisterIo &registers, const PollLimits &pollLimits)
+{
+    if (running) return false;
+    io = registers;
+    limits = pollLimits;
+    last = {};
+    if (!validIo() || !limits.commandPolls || limits.commandPolls > 1000000 ||
+        !limits.transferPolls || limits.transferPolls > 1000000 ||
+        !limits.resetPolls || limits.resetPolls > 1000000 ||
+        !limits.delayUs || limits.delayUs > 1000 ||
+        !limits.cardPolls || limits.cardPolls > 1000) {
+        io = {};
+        return fail(HostError::InvalidArgument, HostPhase::Idle);
+    }
+    return true;
+}
+
+bool PollingHost::fail(HostError error, HostPhase phase, u32 status)
+{
+    last.error = error;
+    last.phase = phase;
+    last.interruptStatus = status;
+    running = false;
+    return false;
+}
+
+void PollingHost::acknowledge(u32 status)
+{
+    io.write32(io.context, kRegInterruptStatus, status & (kPollingStatus | kErrorStatus));
+    if (settle) io.delayUs(io.context, settle);
+}
+
+bool PollingHost::start()
+{
+    running = false;
+    last = {};
+    if (!validIo()) return fail(HostError::InvalidArgument, HostPhase::Reset);
+    io.write32(io.context, kRegInterruptSignal, 0);
+    io.write8(io.context, kRegSoftwareReset, kResetCommand | kResetData);
+    bool reset = false;
+    for (u32 poll = 0; poll < limits.resetPolls; ++poll) {
+        if (!(io.read8(io.context, kRegSoftwareReset) & (kResetCommand | kResetData))) {
+            reset = true;
+            break;
+        }
+        io.delayUs(io.context, limits.delayUs);
+    }
+    if (!reset) return fail(HostError::ResetTimeout, HostPhase::Reset);
+    io.write8(io.context, kRegTimeoutControl, 0x0e);
+    io.write32(io.context, kRegInterruptEnable, kPollingStatus);
+    acknowledge(kPollingStatus);
+    running = true;
+    return true;
+}
+
+void PollingHost::stop()
+{
+    if (validIo()) io.write32(io.context, kRegInterruptSignal, 0);
+    running = false;
+}
+
+bool PollingHost::waitStatus(u32 wanted, u32 &remaining, HostPhase phase, HostError timeout)
+{
+    u32 status = 0;
+    while (remaining) {
+        --remaining;
+        status = io.read32(io.context, kRegInterruptStatus);
+        lastStatus = status;
+        if (status & kErrorStatus) return fail(HostError::Controller, phase, status);
+        if ((status & wanted) == wanted) return true;
+        io.delayUs(io.context, limits.delayUs);
+    }
+    return fail(timeout, phase, status);
+}
+
+bool PollingHost::issue(u8 index, u32 argument, ResponseType type, const DataPhase *data, u32 response[4])
+{
+    last = {};
+    last.command = index;
+    if (!running) return fail(HostError::NotReady, HostPhase::Idle);
+    if (index > 63 || static_cast<u8>(type) > static_cast<u8>(ResponseType::R3) ||
+        (type != ResponseType::None && !response)) {
+        return fail(HostError::InvalidArgument, HostPhase::Idle);
+    }
+    if (data && (type != ResponseType::R1 || !data->blocks ||
+                 data->blocks > (data->dmaTable ? kMaxDmaBlocks : kMaxTransferBlocks) ||
+                 (data->dmaTable ? (data->in || data->out) : !data->in == !data->out))) {
+        return fail(HostError::InvalidArgument, HostPhase::Idle);
+    }
+
+    const u32 inhibit = kPresentCmdInhibit |
+                        ((data || type == ResponseType::R1Busy) ? static_cast<u32>(kPresentDataInhibit) : 0u);
+    bool available = false;
+    for (u32 poll = 0; poll < limits.commandPolls; ++poll) {
+        if (!(io.read32(io.context, kRegPresentState) & inhibit)) {
+            available = true;
+            break;
+        }
+        io.delayUs(io.context, limits.delayUs);
+    }
+    if (!available) return fail(HostError::InhibitTimeout, HostPhase::Inhibit);
+
+    acknowledge(kPollingStatus | kErrorStatus);
+    u16 mode = 0;
+    if (data) {
+        io.write16(io.context, kRegBlockSize, 512);
+        io.write16(io.context, kRegBlockCount, static_cast<u16>(data->blocks));
+        mode = kModeBlockCountEnable | ((data->in || data->dmaTable) ? kModeDirectionRead : 0);
+        if (data->blocks > 1) mode |= kModeMultiBlock | kModeAutoCmd12;
+        if (data->dmaTable) {
+            io.write32(io.context, kRegAdmaAddress, data->dmaTable);
+            io.write32(io.context, kRegAdmaAddress + 4, 0);
+            io.write8(io.context, kRegHostControl1, static_cast<u8>((io.read8(io.context, kRegHostControl1) &
+                                                                     ~kHostDmaSelectMask) | kHostDmaSelectAdma2));
+            mode |= kModeDmaEnable;
+        }
+    }
+    io.write16(io.context, kRegTransferMode, mode);
+    u16 flags = data ? kCmdDataPresent : 0;
+    switch (type) {
+    case ResponseType::None: break;
+    case ResponseType::R1: flags |= kCmdResponse48 | kCmdCrcCheck | kCmdIndexCheck; break;
+    case ResponseType::R1Busy: flags |= kCmdResponse48Busy | kCmdCrcCheck | kCmdIndexCheck; break;
+    case ResponseType::R2: flags |= kCmdResponse136 | kCmdCrcCheck; break;
+    case ResponseType::R3: flags |= kCmdResponse48; break;
+    }
+    io.write32(io.context, kRegArgument, argument);
+    io.write16(io.context, kRegCommand, static_cast<u16>((index << 8) | flags));
+    CommandTrace &trace = history[issued++ % kTraceDepth];
+    trace = {index, argument, 0, 0};
+    lastStatus = 0;
+    u32 remaining = limits.commandPolls;
+    const bool completed = waitStatus(kIntCommandComplete, remaining, HostPhase::Command,
+                                      HostError::CommandTimeout);
+    trace.status = lastStatus;
+    if (!completed) return false;
+    if (type != ResponseType::None) trace.response = io.read32(io.context, kRegResponse);
+    if (response) {
+        for (u32 word = 0; word < 4; ++word) response[word] = 0;
+        if (type == ResponseType::R2) {
+            u32 registers[4];
+            for (u32 word = 0; word < 4; ++word) {
+                registers[word] = io.read32(io.context, kRegResponse + word * 4);
+            }
+            normalizeResponse136(registers, response);
+        } else if (type != ResponseType::None) {
+            response[0] = io.read32(io.context, kRegResponse);
+        }
+    }
+    acknowledge(kIntCommandComplete);
+    if (type == ResponseType::R1 || type == ResponseType::R1Busy) {
+        last.cardStatus = response[0];
+        if (response[0] & kCardErrors) return fail(HostError::CardStatus, HostPhase::Card);
+    }
+    if (type == ResponseType::R1Busy) {
+        remaining = limits.transferPolls;
+        if (!waitStatus(kIntTransferComplete, remaining, HostPhase::Transfer, HostError::DataTimeout)) {
+            return false;
+        }
+        acknowledge(kIntTransferComplete);
+    }
+    return !data || moveData(*data);
+}
+
+// One 512-byte block per buffer-ready event, then the transfer completion. Errors are checked
+// between blocks rather than between words: a status read per FIFO word would double the MMIO
+// cost of every block, and a damaged block is never reported as transferred either way.
+bool PollingHost::moveData(const DataPhase &data)
+{
+    if (data.dmaTable) {
+        // The host walks the descriptor table; an ADMA error (or any other) ends the wait.
+        u32 remaining = limits.transferPolls;
+        if (!waitStatus(kIntTransferComplete, remaining, HostPhase::Transfer, HostError::DataTimeout)) return false;
+        acknowledge(kIntTransferComplete);
+        last.bytesTransferred = data.blocks * 512;
+        return true;
+    }
+    const bool write = data.out != nullptr;
+    const u32 readyBit = write ? kIntBufferWriteReady : kIntBufferReadReady;
+    const u32 presentBit = write ? kPresentBufferWrite : kPresentBufferRead;
+    for (u32 block = 0; block < data.blocks; ++block) {
+        u32 remaining = limits.transferPolls;
+        if (!waitStatus(readyBit, remaining, HostPhase::Buffer, HostError::DataTimeout)) return false;
+        acknowledge(readyBit);
+        bool available = false;
+        while (remaining) {
+            --remaining;
+            const u32 status = io.read32(io.context, kRegInterruptStatus);
+            if (status & kErrorStatus) return fail(HostError::Controller, HostPhase::Buffer, status);
+            if (io.read32(io.context, kRegPresentState) & presentBit) {
+                available = true;
+                break;
+            }
+            io.delayUs(io.context, limits.delayUs);
+        }
+        if (!available) return fail(HostError::DataTimeout, HostPhase::Buffer);
+        if (write) {
+            const u8 *bytes = data.out + block * 512;
+            for (u32 word = 0; word < 128; ++word) {
+                const u8 *at = bytes + word * 4;
+                io.write32(io.context, kRegBufferPort,
+                           static_cast<u32>(at[0]) | (static_cast<u32>(at[1]) << 8) |
+                           (static_cast<u32>(at[2]) << 16) | (static_cast<u32>(at[3]) << 24));
+            }
+        } else {
+            u8 *bytes = data.in + block * 512;
+            for (u32 word = 0; word < 128; ++word) {
+                const u32 value = io.read32(io.context, kRegBufferPort);
+                for (u32 byte = 0; byte < 4; ++byte) bytes[word * 4 + byte] = static_cast<u8>(value >> (byte * 8));
+            }
+        }
+        const u32 status = io.read32(io.context, kRegInterruptStatus);
+        if (status & kErrorStatus) return fail(HostError::Controller, HostPhase::Buffer, status);
+    }
+    // A write completes after the card releases its busy signal, which includes programming.
+    u32 remaining = write ? limits.transferPolls * 4 : limits.transferPolls;
+    if (!waitStatus(kIntTransferComplete, remaining, HostPhase::Transfer, HostError::DataTimeout)) {
+        return false;
+    }
+    acknowledge(kIntTransferComplete);
+    last.bytesTransferred = data.blocks * 512;
+    return true;
+}
+
+bool PollingHost::command(u8 index, u32 argument, ResponseType type, u32 response[4])
+{
+    return issue(index, argument, type, nullptr, response);
+}
+
+bool PollingHost::readBlocks(u8 index, u32 argument, u8 *destination, u32 blocks)
+{
+    const bool single = index == kCmd8SendExtCsd || index == kCmd17ReadSingleBlock;
+    if (!destination || !(single ? blocks == 1 : index == kCmd18ReadMultiple && blocks >= 2)) {
+        last = {};
+        return fail(HostError::InvalidArgument, HostPhase::Idle);
+    }
+    const DataPhase data = {destination, nullptr, blocks, 0};
+    u32 response[4];
+    return issue(index, argument, ResponseType::R1, &data, response);
+}
+
+bool PollingHost::readBlocksDma(u8 index, u32 argument, u32 tablePhys, u32 blocks)
+{
+    if (!tablePhys || (tablePhys & 3) || !(index == kCmd17ReadSingleBlock ? blocks == 1
+                                                                          : index == kCmd18ReadMultiple && blocks >= 2)) {
+        last = {};
+        return fail(HostError::InvalidArgument, HostPhase::Idle);
+    }
+    const DataPhase data = {nullptr, nullptr, blocks, tablePhys};
+    u32 response[4];
+    return issue(index, argument, ResponseType::R1, &data, response);
+}
+
+bool PollingHost::writeBlocks(u8 index, u32 argument, const u8 *source, u32 blocks)
+{
+    if (!source || !(index == kCmd24WriteSingleBlock ? blocks == 1 : index == kCmd25WriteMultiple && blocks >= 2)) {
+        last = {};
+        return fail(HostError::InvalidArgument, HostPhase::Idle);
+    }
+    const DataPhase data = {nullptr, source, blocks, 0};
+    u32 response[4];
+    return issue(index, argument, ResponseType::R1, &data, response);
+}
+
+bool PollingHost::waitCardReady(u16 relativeAddress, u32 state, u32 polls)
+{
+    if (!relativeAddress || (state != kStateStandby && state != kStateTransfer)) {
+        last = {};
+        return fail(HostError::InvalidArgument, HostPhase::Card);
+    }
+    if (!polls) polls = limits.cardPolls;
+    for (u32 poll = 0; poll < polls; ++poll) {
+        u32 response[4];
+        if (!command(kCmd13SendStatus, static_cast<u32>(relativeAddress) << 16,
+                     ResponseType::R1, response)) return false;
+        if ((response[0] & kReadyForData) && cardState(response[0]) == state) return true;
+        io.delayUs(io.context, 1000);
+    }
+    return fail(HostError::CardState, HostPhase::Card);
+}
+
+bool WarmCard::fail(WarmCardError error)
+{
+    lastError = error;
+    attached = false;
+    return false;
+}
+
+void WarmCard::detach()
+{
+    attached = false;
+    host = nullptr;
+}
+
+bool WarmCard::attach(PollingHost &controller, const u16 *candidates, u32 count)
+{
+    detach();
+    card = {};
+    lastError = WarmCardError::None;
+    host = &controller;
+    if (!candidates || !count || count > 16) return fail(WarmCardError::InvalidArgument);
+    u32 response[4];
+    bool selected = false;
+    for (u32 candidate = 0; candidate < count; ++candidate) {
+        if (!candidates[candidate]) continue;
+        if (!host->start()) return fail(WarmCardError::Host);
+        if (!host->command(kCmd13SendStatus, static_cast<u32>(candidates[candidate]) << 16,
+                           ResponseType::R1, response)) continue;
+        const u32 state = cardState(response[0]);
+        if (!(response[0] & kReadyForData) || (state != kStateStandby && state != kStateTransfer)) {
+            return fail(WarmCardError::UnexpectedState);
+        }
+        card.relativeAddress = candidates[candidate];
+        selected = state == kStateTransfer;
+        break;
+    }
+    if (!card.relativeAddress) return fail(WarmCardError::NoRelativeAddress);
+    return finish(selected);
+}
+
+bool WarmCard::initialize(PollingHost &controller, u16 relativeAddress, const BusControl &bus, u32 transferHz)
+{
+    detach();
+    card = {};
+    lastError = WarmCardError::None;
+    host = &controller;
+    if (!relativeAddress || !bus.setClock || !bus.setBusWidth || !transferHz || transferHz > 26000000) {
+        return fail(WarmCardError::InvalidArgument);
+    }
+    card.cold = true;
+    if (!bus.setBusWidth(bus.context, 1) || !bus.setClock(bus.context, kIdentificationHz)) {
+        return fail(WarmCardError::BusClock);
+    }
+    host->setClearSettle(40);
+    if (!host->start() || !host->command(kCmd0GoIdleState, 0, ResponseType::None, nullptr)) {
+        return fail(WarmCardError::Host);
+    }
+    host->pause(1000);
+    u32 response[4];
+    for (u32 poll = 0; poll < kOperatingConditionPolls; ++poll) {
+        if (!host->command(kCmd1SendOpCond, kOcrRequest, ResponseType::R3, response)) {
+            return fail(WarmCardError::Host);
+        }
+        card.ocr = response[0];
+        if (card.ocr & kOcrReady) break;
+        host->pause(1000);
+    }
+    if (!(card.ocr & kOcrReady)) return fail(WarmCardError::OperatingCondition);
+    if (!(card.ocr & kOcrSectorMode)) return fail(WarmCardError::UnsupportedCard);
+    if (!host->command(kCmd2AllSendCid, 0, ResponseType::R2, response)) return fail(WarmCardError::Host);
+    for (u32 word = 0; word < 4; ++word) card.cid[word] = response[word];
+    // CMD3 once completed nothing on hardware (no response, no timeout status). Reset the
+    // command line and send it again; if the card already took the address it no longer
+    // answers CMD3 in standby, so CMD13 settles which case it was.
+    const u32 address = static_cast<u32>(relativeAddress) << 16;
+    bool assigned = host->command(kCmd3SetRelativeAddr, address, ResponseType::R1, response);
+    if (!assigned && host->start()) {
+        assigned = host->command(kCmd3SetRelativeAddr, address, ResponseType::R1, response);
+        if (!assigned && host->start()) {
+            assigned = host->command(kCmd13SendStatus, address, ResponseType::R1, response) &&
+                       cardState(response[0]) == kStateStandby;
+        }
+    }
+    if (!assigned) return fail(WarmCardError::Host);
+    card.relativeAddress = relativeAddress;
+    if (!bus.setClock(bus.context, transferHz)) return fail(WarmCardError::BusClock);
+    host->setClearSettle(0);
+    card.clockHz = transferHz;
+    return finish(false);
+}
+
+bool WarmCard::finish(bool selected)
+{
+    u32 response[4];
+    if (selected && !host->command(kCmd7SelectCard, 0, ResponseType::None, nullptr)) {
+        return fail(WarmCardError::Host);
+    }
+    if (!host->waitCardReady(card.relativeAddress, kStateStandby) ||
+        !host->command(kCmd9SendCsd, static_cast<u32>(card.relativeAddress) << 16,
+                       ResponseType::R2, response)) return fail(WarmCardError::Host);
+    const bool validCsd = decodeCsd(response, &card.csd);
+    if (!host->command(kCmd7SelectCard, static_cast<u32>(card.relativeAddress) << 16,
+                       ResponseType::R1, response) ||
+        !host->waitCardReady(card.relativeAddress, kStateTransfer)) return fail(WarmCardError::Host);
+    if (!validCsd) return fail(WarmCardError::InvalidCsd);
+    if (card.csd.mmcVersion < 4) return fail(WarmCardError::UnsupportedCard);
+    if (!readExtCsd()) return false;
+    if (card.extCsd.partitionAccess) return fail(WarmCardError::WrongPartition);
+    if (card.extCsd.commandQueueEnabled) return fail(WarmCardError::CommandQueue);
+    if (card.extCsd.revision < 2 || card.extCsd.sectorBytes != 512 ||
+        card.extCsd.capacityBytes <= (2ULL << 30)) return fail(WarmCardError::UnsupportedCard);
+    if (!host->waitCardReady(card.relativeAddress, kStateTransfer)) return fail(WarmCardError::Host);
+    card.capacityBytes = card.extCsd.capacityBytes;
+    attached = true;
+    return true;
+}
+
+bool WarmCard::readExtCsd()
+{
+    u8 extCsd[512];
+    if (!host->readBlocks(kCmd8SendExtCsd, 0, extCsd, 1)) return fail(WarmCardError::Host);
+    if (!decodeExtCsd(extCsd, sizeof extCsd, &card.extCsd)) return fail(WarmCardError::InvalidExtCsd);
+    return true;
+}
+
+bool WarmCard::switchExtCsd(u8 index, u8 value)
+{
+    u32 response[4];
+    // CMD6 access 3 (write byte): the card answers R1b and reports SWITCH_ERROR in the next status.
+    return host->command(kCmd6Switch, (3u << 24) | (static_cast<u32>(index) << 16) | (static_cast<u32>(value) << 8),
+                         ResponseType::R1Busy, response) &&
+           host->waitCardReady(card.relativeAddress, kStateTransfer, kProgramPolls);
+}
+
+bool WarmCard::recover()
+{
+    if (!attached || !host) return fail(WarmCardError::InvalidArgument);
+    if (!host->start()) return fail(WarmCardError::Host);
+    u32 response[4];
+    // CMD12 is illegal in the transfer state; the card only flags it in the next status, so its
+    // failure says nothing and the state wait decides.
+    host->command(kCmd12StopTransmission, 0, ResponseType::R1Busy, response);
+    if (!host->waitCardReady(card.relativeAddress, kStateTransfer, kProgramPolls)) return fail(WarmCardError::Host);
+    return true;
+}
+
+bool WarmCard::upgrade(const BusControl &bus, u32 highSpeedHz)
+{
+    if (!ready() || !bus.setClock || !bus.setBusWidth) return fail(WarmCardError::InvalidArgument);
+    // BUS_WIDTH is write-only (it reads back 0 on hardware), so the 8-bit bus is proved the way
+    // Linux's bus test does it: EXT_CSD read through the new width, CRC-checked by the host,
+    // must repeat the read-only fields of the 1-bit read.
+    const ExtCsdInfo legacy = card.extCsd;
+    if (!switchExtCsd(kExtCsdBusWidth, 2)) return fail(WarmCardError::Host);
+    if (!bus.setBusWidth(bus.context, 8)) return fail(WarmCardError::BusMode);
+    if (!readExtCsd()) return false;
+    if (card.extCsd.capacityBytes != legacy.capacityBytes || card.extCsd.revision != legacy.revision ||
+        card.extCsd.deviceType != legacy.deviceType || card.extCsd.sectorBytes != legacy.sectorBytes) {
+        return fail(WarmCardError::BusMode);
+    }
+    card.busWidth = 8;
+    if ((card.extCsd.deviceType & 2) && highSpeedHz > 26000000) {
+        if (!switchExtCsd(kExtCsdHsTiming, 1)) return fail(WarmCardError::Host);
+        if (!bus.setClock(bus.context, highSpeedHz)) return fail(WarmCardError::BusClock);
+        if (!readExtCsd()) return false;
+        if (card.extCsd.hsTiming != 1) return fail(WarmCardError::BusMode);
+        card.clockHz = highSpeedHz;
+    }
+    return true;
+}
+
+bool WarmCard::readBlocks(u64 lba, u32 count, u8 *destination)
+{
+    const u64 sectors = card.capacityBytes / 512;
+    if (!ready() || !destination || !count || count > kMaxTransferBlocks || lba >= sectors ||
+        count > sectors - lba || lba > 0xffffffffULL) {
+        return false;
+    }
+    const bool ok = count == 1 ? host->readBlocks(kCmd17ReadSingleBlock, static_cast<u32>(lba), destination, 1)
+                               : host->readBlocks(kCmd18ReadMultiple, static_cast<u32>(lba), destination, count);
+    if (!ok) return fail(WarmCardError::Host);
+    return true;
+}
+
+bool WarmCard::readBlocksDma(u64 lba, u32 count, u32 tablePhys)
+{
+    const u64 sectors = card.capacityBytes / 512;
+    if (!ready() || !tablePhys || !count || count > kMaxDmaBlocks || lba >= sectors || count > sectors - lba ||
+        lba > 0xffffffffULL) {
+        return false;
+    }
+    // A failed DMA read leaves the card attached (unlike fail()): the caller recovers it and reads by PIO.
+    if (!host->readBlocksDma(count == 1 ? kCmd17ReadSingleBlock : kCmd18ReadMultiple, static_cast<u32>(lba),
+                             tablePhys, count)) {
+        lastError = WarmCardError::Host;
+        return false;
+    }
+    return true;
+}
+
+void WarmCard::allowWrites(u64 firstLba, u64 lastLba)
+{
+    const u64 sectors = card.capacityBytes / 512;
+    if (!sectors || lastLba < firstLba || lastLba >= sectors || !lastLba) {
+        writeFirst = 1;
+        writeLast = 0;
+        return;
+    }
+    writeFirst = firstLba;
+    writeLast = lastLba;
+}
+
+bool WarmCard::writeBlocks(u64 lba, u32 count, const u8 *source)
+{
+    if (!ready() || !source || !count || count > kMaxTransferBlocks) return false;
+    // A refused write is the caller's mistake, not a card failure: report it without detaching.
+    if (!writable() || lba < writeFirst || lba > writeLast || count - 1 > writeLast - lba) {
+        lastError = WarmCardError::WriteRefused;
+        return false;
+    }
+    const bool ok = count == 1 ? host->writeBlocks(kCmd24WriteSingleBlock, static_cast<u32>(lba), source, 1)
+                               : host->writeBlocks(kCmd25WriteMultiple, static_cast<u32>(lba), source, count);
+    if (!ok || !host->waitCardReady(card.relativeAddress, kStateTransfer, kProgramPolls)) {
+        return fail(WarmCardError::Host);
+    }
+    return true;
+}
+
+const char *hostErrorName(HostError error)
+{
+    switch (error) {
+    case HostError::None: return "none";
+    case HostError::InvalidArgument: return "invalid argument";
+    case HostError::NotReady: return "not ready";
+    case HostError::ResetTimeout: return "reset timeout";
+    case HostError::InhibitTimeout: return "inhibit timeout";
+    case HostError::CommandTimeout: return "command timeout";
+    case HostError::DataTimeout: return "data timeout";
+    case HostError::Controller: return "controller error";
+    case HostError::CardStatus: return "card status error";
+    case HostError::CardState: return "unexpected card state";
+    }
+    return "unknown";
+}
+
+}
diff --git a/drivers/NativeSdhci/PollingHost.h b/drivers/NativeSdhci/PollingHost.h
new file mode 100644
index 0000000..594cf0b
--- /dev/null
+++ b/drivers/NativeSdhci/PollingHost.h
@@ -0,0 +1,182 @@
+#ifndef NATIVE_SDHCI_POLLING_HOST_H
+#define NATIVE_SDHCI_POLLING_HOST_H
+
+#include "SdhciCore.h"
+
+namespace sdhci {
+
+struct RegisterIo {
+    void *context;
+    u8 (*read8)(void *, u32);
+    u32 (*read32)(void *, u32);
+    void (*write8)(void *, u32, u8);
+    void (*write16)(void *, u32, u16);
+    void (*write32)(void *, u32, u32);
+    void (*delayUs)(void *, u32);
+};
+
+struct PollLimits {
+    u32 commandPolls = 10000;
+    u32 transferPolls = 50000;   // per 512-byte block
+    u32 resetPolls = 10000;
+    u32 delayUs = 10;
+    u32 cardPolls = 100;
+};
+
+// Most blocks one data command moves (the block count register is 16 bits; this bounds a
+// single PIO burst and the caller's bounce buffer).
+constexpr u32 kMaxTransferBlocks = 128;
+// Most blocks one ADMA2 read moves (512 KiB): fewer commands, each paying the card's access time once
+// (boot 19: 64 KiB commands read at ~27 MB/s on a 52 MB/s bus).
+constexpr u32 kMaxDmaBlocks = 1024;
+
+// R3 is the OCR answer to CMD1: 48 bits with neither CRC nor index.
+enum class ResponseType : u8 { None, R1, R1Busy, R2, R3 };
+enum class HostError : u8 {
+    None, InvalidArgument, NotReady, ResetTimeout, InhibitTimeout,
+    CommandTimeout, DataTimeout, Controller, CardStatus, CardState
+};
+enum class HostPhase : u8 { Idle, Reset, Inhibit, Command, Buffer, Transfer, Card };
+
+struct HostResult {
+    HostError error = HostError::None;
+    HostPhase phase = HostPhase::Idle;
+    u32 interruptStatus = 0;
+    u32 cardStatus = 0;
+    u32 bytesTransferred = 0;
+    u8 command = 0;
+};
+
+// One issued command and how it ended, for the bring-up log.
+struct CommandTrace {
+    u8 index;
+    u32 argument;
+    u32 status;
+    u32 response;
+};
+
+class PollingHost {
+public:
+    bool configure(const RegisterIo &registers, const PollLimits &pollLimits = {});
+    bool start();
+    void stop();
+    bool command(u8 index, u32 argument, ResponseType type, u32 response[4]);
+    // Programmed-I/O data commands. Reads: CMD8 (EXT_CSD) and CMD17 one block, CMD18 two or more.
+    // Writes: CMD24 one block, CMD25 two or more. Multi-block commands end with Auto CMD12.
+    // A failed read leaves the destination partly written; nothing reports it as data.
+    bool readBlocks(u8 index, u32 argument, u8 *destination, u32 blocks);
+    // The same reads by ADMA2: the host moves the data itself to where the 32-bit descriptor table at
+    // tablePhys points (table and buffers below 4 GiB, the table already cleaned to memory); only the
+    // transfer completion is polled.
+    bool readBlocksDma(u8 index, u32 argument, u32 tablePhys, u32 blocks);
+    bool writeBlocks(u8 index, u32 argument, const u8 *source, u32 blocks);
+    bool waitCardReady(u16 relativeAddress, u32 state, u32 polls = 0);
+    void pause(u32 microseconds) { if (io.delayUs) io.delayUs(io.context, microseconds); }
+    // Delay after every interrupt-status clear. The QSDCC host synchronises the clear
+    // into the card clock domain, so at 400 kHz it lands late (sdhci-msm's
+    // SDHCI_QUIRK2_SLOW_INT_CLR waits 40 us there).
+    void setClearSettle(u32 microseconds) { settle = microseconds; }
+    // The `back`-th most recent command (0 is the last), or nullptr.
+    const CommandTrace *recent(u32 back) const
+    {
+        return back < kTraceDepth && back < issued ? &history[(issued - 1 - back) % kTraceDepth] : nullptr;
+    }
+    bool ready() const { return running; }
+    const HostResult &result() const { return last; }
+
+private:
+    struct DataPhase {
+        u8 *in;
+        const u8 *out;
+        u32 blocks;
+        u32 dmaTable;   // nonzero: an ADMA2 read through this descriptor table, in and out unused
+    };
+    bool issue(u8 index, u32 argument, ResponseType type, const DataPhase *data, u32 response[4]);
+    bool moveData(const DataPhase &data);
+    bool waitStatus(u32 wanted, u32 &remaining, HostPhase phase, HostError timeout);
+    bool fail(HostError error, HostPhase phase, u32 status = 0);
+    void acknowledge(u32 status);
+    bool validIo() const;
+
+    static constexpr u32 kTraceDepth = 8;
+    RegisterIo io = {};
+    PollLimits limits = {};
+    HostResult last = {};
+    CommandTrace history[kTraceDepth] = {};
+    u32 issued = 0;
+    u32 lastStatus = 0;
+    u32 settle = 0;
+    bool running = false;
+};
+
+enum class WarmCardError : u8 {
+    None, InvalidArgument, Host, NoRelativeAddress, UnexpectedState,
+    InvalidCsd, InvalidExtCsd, UnsupportedCard, WrongPartition, CommandQueue,
+    BusClock, OperatingCondition, BusMode, WriteRefused
+};
+
+// The board's card clock and bus. A cold identification runs at 400 kHz on one data line and the
+// transfer state at the rate the board picks. setClock also selects the host's high-speed timing for
+// rates above 26 MHz; setBusWidth takes 1 or 8.
+struct BusControl {
+    void *context;
+    bool (*setClock)(void *, u32 hz);
+    bool (*setBusWidth)(void *, u32 bits);
+};
+
+struct WarmCardInfo {
+    u16 relativeAddress = 0;
+    u32 ocr = 0;
+    u32 cid[4] = {};
+    bool cold = false;
+    u32 busWidth = 1;
+    u32 clockHz = 0;
+    CsdInfo csd = {};
+    ExtCsdInfo extCsd = {};
+    u64 capacityBytes = 0;
+};
+
+class WarmCard {
+public:
+    bool attach(PollingHost &controller, const u16 *candidates, u32 count);
+    // Identify the card from CMD0, for when the firmware's selected card does not
+    // answer: assigns relativeAddress and leaves the card selected at transferHz.
+    bool initialize(PollingHost &controller, u16 relativeAddress, const BusControl &bus, u32 transferHz);
+    // After a cold initialize: 8-bit bus, then high-speed timing at highSpeedHz when EXT_CSD
+    // offers it. Each step is proved by reading EXT_CSD back through the new bus mode. On false
+    // the card is in an unknown bus mode and must be initialized again.
+    bool upgrade(const BusControl &bus, u32 highSpeedHz);
+    bool readBlocks(u64 lba, u32 count, u8 *destination);
+    bool readBlock(u64 lba, u8 *destination) { return readBlocks(lba, 1, destination); }
+    // ADMA2 read of count blocks through the descriptor table at tablePhys (see PollingHost::readBlocksDma).
+    bool readBlocksDma(u64 lba, u32 count, u32 tablePhys);
+    // Writes are refused unless every block lies in the window allowWrites opened.
+    void allowWrites(u64 firstLba, u64 lastLba);
+    bool writeBlocks(u64 lba, u32 count, const u8 *source);
+    bool writable() const { return writeLast >= writeFirst && writeLast; }
+    // For a transfer that was cut off (a panic in the middle of one): reset the host's command and
+    // data lines, stop whatever the card was transferring and wait for it to return to transfer state.
+    bool recover();
+    void detach();
+    bool ready() const { return attached && host && host->ready(); }
+    const WarmCardInfo &info() const { return card; }
+    WarmCardError error() const { return lastError; }
+
+private:
+    bool fail(WarmCardError error);
+    bool finish(bool selected);
+    bool switchExtCsd(u8 index, u8 value);
+    bool readExtCsd();
+    PollingHost *host = nullptr;
+    WarmCardInfo card = {};
+    WarmCardError lastError = WarmCardError::None;
+    u64 writeFirst = 1;
+    u64 writeLast = 0;
+    bool attached = false;
+};
+
+const char *hostErrorName(HostError error);
+
+}
+
+#endif
diff --git a/drivers/NativeSdhci/SdhciCore.cpp b/drivers/NativeSdhci/SdhciCore.cpp
new file mode 100644
index 0000000..0148b4c
--- /dev/null
+++ b/drivers/NativeSdhci/SdhciCore.cpp
@@ -0,0 +1,195 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#include "SdhciCore.h"
+#include "SdhciRegs.h"
+
+namespace sdhci {
+
+bool decodeCsd(const u32 csd[4], CsdInfo *out)
+{
+    if (!csd || !out) return false;
+
+    const u32 structure   = csd[0] >> 30;
+    const u32 readBlockLen = (csd[1] >> 16) & 0xF;
+    const u32 cSize        = ((csd[1] & 0x3FF) << 2) | (csd[2] >> 30);
+    const u32 cSizeMult    = (csd[2] >> 15) & 0x7;
+
+    if (!structure || readBlockLen < 9 || readBlockLen > 11) return false;
+
+    CsdInfo info = {};
+    info.structure    = structure;
+    info.mmcVersion   = (csd[0] >> 26) & 0xf;
+    info.readBlockLen = readBlockLen;
+    info.cSize        = cSize;
+    info.cSizeMult    = cSizeMult;
+
+    info.saturated = info.mmcVersion >= 4 && cSize == 0xfff;
+    const u64 blocks = static_cast<u64>(cSize) + 1;
+    const u64 mult = static_cast<u64>(1) << (cSizeMult + 2);
+    const u64 length = static_cast<u64>(1) << readBlockLen;
+    info.capacityBytes = info.saturated ? 0 : blocks * mult * length;
+
+    *out = info;
+    return true;
+}
+
+void normalizeResponse136(const u32 registers[4], u32 response[4])
+{
+    if (!registers || !response) return;
+    u32 normalized[4];
+    for (u32 word = 0; word < 4; ++word) {
+        normalized[word] = registers[3 - word] << 8;
+        if (word != 3) normalized[word] |= registers[2 - word] >> 24;
+    }
+    for (u32 word = 0; word < 4; ++word) response[word] = normalized[word];
+}
+
+bool decodeExtCsd(const u8 *bytes, u32 length, ExtCsdInfo *out)
+{
+    if (!bytes || length != 512 || !out || bytes[194] > 2 || bytes[61] > 1) return false;
+    ExtCsdInfo info = {};
+    info.capacityBytes = parseExtCsdSectorCount(bytes);
+    info.sectorBytes = bytes[61] ? 4096 : 512;
+    info.revision = bytes[192];
+    info.partitionAccess = bytes[179] & 7;
+    info.busWidth = bytes[183];
+    info.hsTiming = bytes[185];
+    info.deviceType = bytes[196];
+    info.commandQueueEnabled = (bytes[15] & 1) != 0;
+    *out = info;
+    return true;
+}
+
+u64 parseExtCsdSectorCount(const u8 extCsd[512])
+{
+    if (!extCsd) return 0;
+    const u32 sectors = static_cast<u32>(extCsd[212]) |
+                             (static_cast<u32>(extCsd[213]) << 8) |
+                             (static_cast<u32>(extCsd[214]) << 16) |
+                             (static_cast<u32>(extCsd[215]) << 24);
+    return static_cast<u64>(sectors) * 512;
+}
+
+u32 clockDivider(u32 baseHz, u32 targetHz)
+{
+    if (!baseHz || !targetHz) return 0;
+
+    // The card clock is base / (2 * divider), so round the divider up to keep
+    // the result at or below the target.
+    const u64 denominator = static_cast<u64>(targetHz) * 2;
+    u64 divider = (static_cast<u64>(baseHz) + denominator - 1) / denominator;
+    if (divider < 1) divider = 1;
+    if (divider > 1023) return 0;
+    return static_cast<u32>(divider);
+}
+
+u16 encodeDivider(u32 divider)
+{
+    divider &= 0x3FF;
+    return static_cast<u16>((((divider >> 8) & 0x3) << 6) | ((divider & 0xFF) << 8));
+}
+
+u32 decodeDivider(u16 clockControl)
+{
+    return ((static_cast<u32>(clockControl) >> 6) & 0x3) << 8 |
+           ((static_cast<u32>(clockControl) >> 8) & 0xFF);
+}
+
+u32 buildAdma2(const Adma2Chunk *chunks, u32 count, u64 *table, u32 tableEntries)
+{
+    if (!chunks || !count || !table || count > tableEntries) return 0;
+
+    for (u32 index = 0; index < count; ++index) {
+        const Adma2Chunk &chunk = chunks[index];
+        if (!chunk.length || chunk.length > 0x10000 || (chunk.length & 3)) return 0;
+        if (chunk.phys & 3) return 0;
+        // ADMA2 descriptors carry a 32-bit address; the Lumia eMMC controller
+        // has no SMMU context, so every buffer must be reachable below 4 GiB.
+        if (chunk.phys > 0xFFFFFFFFULL) return 0;
+
+        u16 attributes = kAdma2AttrValid | kAdma2AttrActTransfer;
+        if (index + 1 == count) attributes |= kAdma2AttrEnd;
+
+        // A length of 65536 is encoded as zero, which the controller reads as
+        // the full 64 KiB.
+        const u64 length = chunk.length & 0xFFFF;
+        table[index] = static_cast<u64>(attributes) | (length << 16) | (chunk.phys << 32);
+    }
+    return count;
+}
+
+u64 maxValidLba(u64 capacityBytes)
+{
+    return capacityBytes >= 512 ? capacityBytes / 512 - 1 : 0;
+}
+
+u32 crc32(const u8 *bytes, u32 length)
+{
+    u32 crc = 0xffffffffu;
+    for (u32 index = 0; index < length; ++index) {
+        crc ^= bytes[index];
+        for (u32 bit = 0; bit < 8; ++bit) crc = (crc >> 1) ^ (0xedb88320u & (0u - (crc & 1)));
+    }
+    return ~crc;
+}
+
+namespace {
+u32 le32(const u8 *at)
+{
+    return static_cast<u32>(at[0]) | (static_cast<u32>(at[1]) << 8) |
+           (static_cast<u32>(at[2]) << 16) | (static_cast<u32>(at[3]) << 24);
+}
+
+u64 le64(const u8 *at)
+{
+    return static_cast<u64>(le32(at)) | (static_cast<u64>(le32(at + 4)) << 32);
+}
+
+bool entryUsed(const u8 *entry)
+{
+    u8 used = 0;
+    for (u32 index = 0; index < 16; ++index) used |= entry[index];
+    return used != 0;
+}
+
+bool entryNamed(const u8 *entry, const char *name)
+{
+    u32 index = 0;
+    for (; name[index]; ++index) {
+        if (index >= 36 || entry[56 + 2 * index] != static_cast<u8>(name[index]) || entry[57 + 2 * index]) return false;
+    }
+    return index == 36 || (entry[56 + 2 * index] == 0 && entry[57 + 2 * index] == 0);
+}
+}
+
+bool findGptPartition(const u8 *header, const u8 *entries, u32 entriesBytes, u64 lastLba,
+                      const char *name, GptRange *out)
+{
+    if (!header || !entries || !name || !name[0] || !out) return false;
+    if (le64(header) != 0x5452415020494645ULL || le32(header + 8) != 0x00010000) return false;
+    const u32 headerBytes = le32(header + 12);
+    if (headerBytes < 92 || headerBytes > 512 || le32(header + 20) || le64(header + 24) != 1) return false;
+    u8 copy[512];
+    for (u32 index = 0; index < headerBytes; ++index) copy[index] = header[index];
+    for (u32 index = 16; index < 20; ++index) copy[index] = 0;
+    if (crc32(copy, headerBytes) != le32(header + 16)) return false;
+    const u64 firstUsable = le64(header + 40), lastUsable = le64(header + 48);
+    const u32 count = le32(header + 80), entryBytes = le32(header + 84);
+    if (entryBytes != 128 || !count || count > 256 || count * entryBytes > entriesBytes ||
+        le64(header + 72) < 2 || lastUsable < firstUsable || lastUsable > lastLba) return false;
+    if (crc32(entries, count * entryBytes) != le32(header + 88)) return false;
+    bool found = false;
+    GptRange range = {};
+    for (u32 index = 0; index < count; ++index) {
+        const u8 *entry = entries + index * entryBytes;
+        if (!entryUsed(entry) || !entryNamed(entry, name)) continue;
+        const u64 first = le64(entry + 32), last = le64(entry + 40);
+        if (found || first < firstUsable || last < first || last > lastUsable) return false;
+        range = {first, last};
+        found = true;
+    }
+    if (!found) return false;
+    *out = range;
+    return true;
+}
+
+} // namespace sdhci
diff --git a/drivers/NativeSdhci/SdhciCore.h b/drivers/NativeSdhci/SdhciCore.h
new file mode 100644
index 0000000..895035d
--- /dev/null
+++ b/drivers/NativeSdhci/SdhciCore.h
@@ -0,0 +1,89 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+//
+// Host-testable part of the Lumia 950 eMMC driver: the arithmetic and the
+// table decoding. Nothing here touches hardware, IOKit or XNU, so it compiles
+// and runs on the build host (drivers/NativeSdhci/Test/check-sdhci-core.cpp).
+#ifndef NATIVE_SDHCI_CORE_H
+#define NATIVE_SDHCI_CORE_H
+
+#include "SdhciTypes.h"
+
+namespace sdhci {
+
+// Decoded CSD. eMMC parts above 2 GiB report a saturated CSD, so capacity for
+// those comes from EXT_CSD (parseExtCsdSectorCount) instead.
+struct CsdInfo {
+    u32 structure;
+    u32 mmcVersion;
+    u32 readBlockLen;    // log2 of the block length
+    u32 cSize;
+    u32 cSizeMult;
+    u64 capacityBytes;   // from the CSD alone; 0 when it cannot express it
+    bool saturated;
+};
+
+// Decodes a 128-bit CSD as four big-endian words, csd[0] holding bits 127..96.
+bool decodeCsd(const u32 csd[4], CsdInfo *out);
+
+void normalizeResponse136(const u32 registers[4], u32 response[4]);
+
+struct ExtCsdInfo {
+    u64 capacityBytes;
+    u32 sectorBytes;
+    u8 revision;
+    u8 partitionAccess;
+    u8 busWidth;         // BUS_WIDTH [183]: write-only, reads back 0 on real cards
+    u8 hsTiming;         // HS_TIMING [185]: 0 legacy, 1 high speed
+    u8 deviceType;       // DEVICE_TYPE [196]: bit 1 = high speed at 52 MHz
+    bool commandQueueEnabled;
+};
+
+bool decodeExtCsd(const u8 *bytes, u32 length, ExtCsdInfo *out);
+
+// Reads SEC_COUNT (offset 212, little-endian, 512-byte units) from a 512-byte
+// EXT_CSD image. Returns 0 when the image cannot describe a usable capacity.
+u64 parseExtCsdSectorCount(const u8 extCsd[512]);
+
+// SDHCI 3.0 clock arithmetic: the card clock is base / (2 * divider), with a
+// 10-bit divider and 1 as its minimum. Returns 0 when targetHz is unreachable.
+u32 clockDivider(u32 baseHz, u32 targetHz);
+
+// Encodes a 10-bit divider into Clock Control bits [7:6] (high two bits) and
+// [15:8] (low eight bits), and decodes it back.
+u16 encodeDivider(u32 divider);
+u32 decodeDivider(u16 clockControl);
+
+// One ADMA2 transfer chunk: a physical address and a length of at most 64 KiB
+// in a multiple of 4 bytes.
+struct Adma2Chunk {
+    u64 phys;
+    u32 length;
+};
+
+// Writes an ADMA2 descriptor table for the chunks and marks the last descriptor
+// as the end. Returns the descriptor count, or 0 on a malformed chunk or when
+// the table is too small. Descriptors are 8 bytes each in the host's byte order.
+u32 buildAdma2(const Adma2Chunk *chunks, u32 count, u64 *table, u32 tableEntries);
+
+// Last valid 512-byte LBA of a medium, or 0 for an empty one.
+u64 maxValidLba(u64 capacityBytes);
+
+// The reflected IEEE CRC-32 GPT uses.
+u32 crc32(const u8 *bytes, u32 length);
+
+// A partition's inclusive 512-byte LBA range.
+struct GptRange {
+    u64 first;
+    u64 last;
+};
+
+// Finds the one partition named `name` (ASCII, compared with the UTF-16LE GPT name) in a primary GPT:
+// `header` is LBA 1 (512 bytes) and `entries` the partition array it points to, `entriesBytes` long.
+// Both CRCs, the header revision and size, the entry geometry and the partition bounds against the
+// usable range and `lastLba` of the medium are checked; a missing or duplicated name is refused.
+bool findGptPartition(const u8 *header, const u8 *entries, u32 entriesBytes, u64 lastLba,
+                      const char *name, GptRange *out);
+
+} // namespace sdhci
+
+#endif // NATIVE_SDHCI_CORE_H
diff --git a/drivers/NativeSdhci/SdhciRegs.h b/drivers/NativeSdhci/SdhciRegs.h
new file mode 100644
index 0000000..236c39f
--- /dev/null
+++ b/drivers/NativeSdhci/SdhciRegs.h
@@ -0,0 +1,188 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+//
+// SDHCI host controller registers, as used by the Lumia 950 (MSM8992) eMMC.
+//
+// Offsets follow the SDHCI specification (Host Controller 3.0 layout, which is
+// what Linux's drivers/mmc/host/sdhci.h uses) and are relative to the "hc"
+// window at 0xf9824900 on this board. Note that the interrupt registers are
+// 32-bit words at 0x30/0x34/0x38: the low half is the normal status and the
+// high half the error status.
+//
+// Only the standard register set is defined. The Qualcomm QSDCC vendor window
+// ("core" in the device tree) holds the DLL and power-control registers needed
+// for HS200/HS400; those offsets are deliberately absent until they are
+// confirmed against the firmware that programs them. See README.md, "Vendor
+// registers".
+#ifndef NATIVE_SDHCI_REGS_H
+#define NATIVE_SDHCI_REGS_H
+
+#include "SdhciTypes.h"
+
+namespace sdhci {
+
+// Register offsets, relative to the "hc" window.
+enum : u32 {
+    kRegDmaAddress       = 0x00,
+    kRegBlockSize        = 0x04,
+    kRegBlockCount       = 0x06,
+    kRegArgument         = 0x08,
+    kRegTransferMode     = 0x0C,
+    kRegCommand          = 0x0E,
+    kRegResponse         = 0x10,   // 0x10..0x1F
+    kRegBufferPort       = 0x20,
+    kRegPresentState     = 0x24,
+    kRegHostControl1     = 0x28,
+    kRegPowerControl     = 0x29,
+    kRegBlockGapControl  = 0x2A,
+    kRegWakeUpControl    = 0x2B,
+    kRegClockControl     = 0x2C,
+    kRegTimeoutControl   = 0x2E,
+    kRegSoftwareReset    = 0x2F,
+    kRegInterruptStatus  = 0x30,   // 32-bit: normal in the low half, error in the high half
+    kRegInterruptEnable  = 0x34,
+    kRegInterruptSignal  = 0x38,
+    kRegAutoCmd12Error   = 0x3C,
+    kRegHostControl2     = 0x3E,
+    kRegCapabilities     = 0x40,
+    kRegCapabilities1    = 0x44,
+    kRegMaxCurrent       = 0x48,
+    kRegAdmaErrorStatus  = 0x54,
+    kRegAdmaAddress      = 0x58,   // 64-bit address in 0x58 and 0x5C
+    kRegPresetValue      = 0x60,   // 0x60..0x7F
+    kRegSlotIntStatus    = 0xFC,
+    kRegHostVersion      = 0xFE,
+};
+
+// Present State (0x24, 32-bit)
+enum : u32 {
+    kPresentCmdInhibit    = 0x00000001,
+    kPresentDataInhibit   = 0x00000002,
+    kPresentDatLineActive = 0x00000004,
+    kPresentWriteTransfer = 0x00000100,
+    kPresentReadTransfer  = 0x00000200,
+    kPresentBufferWrite   = 0x00000400,   // space available for the host to write
+    kPresentBufferRead    = 0x00000800,   // data available for the host to read
+    kPresentCardInserted  = 0x00010000,
+};
+
+// Command (0x0E, 16-bit)
+enum : u16 {
+    kCmdResponseNone      = 0x00,
+    kCmdResponse136       = 0x01,
+    kCmdResponse48        = 0x02,
+    kCmdResponse48Busy    = 0x03,
+    kCmdCrcCheck          = 0x08,
+    kCmdIndexCheck        = 0x10,
+    kCmdDataPresent       = 0x20,
+};
+
+// Transfer Mode (0x0C, 16-bit)
+enum : u16 {
+    kModeDmaEnable        = 0x01,
+    kModeBlockCountEnable = 0x02,
+    kModeAutoCmd12        = 0x04,
+    kModeAutoCmd23        = 0x08,
+    kModeDirectionRead    = 0x10,
+    kModeMultiBlock       = 0x20,
+};
+
+// Host Control 1 (0x28, 8-bit)
+enum : u8 {
+    kHostLedPower         = 0x01,
+    kHostDataWidth4       = 0x02,
+    kHostHighSpeed        = 0x04,
+    kHostDmaSelectMask    = 0x18,
+    kHostDmaSelectSdma    = 0x00,
+    kHostDmaSelectAdma1   = 0x08,
+    kHostDmaSelectAdma2   = 0x10,
+    kHostDmaSelectAdma64  = 0x18,
+    kHostDataWidth8       = 0x20,
+};
+
+// Power Control (0x29, 8-bit)
+enum : u8 {
+    kPowerBusOn           = 0x01,
+    kPowerVoltage180      = 0x0A,
+    kPowerVoltage300      = 0x0C,
+    kPowerVoltage330      = 0x0E,
+};
+
+// Clock Control (0x2C, 16-bit): the divider's low eight bits sit at bits 15..8
+// and its high two bits at bits 7..6.
+enum : u16 {
+    kClockInternalEnable  = 0x0001,
+    kClockInternalStable  = 0x0002,
+    kClockSdClockEnable   = 0x0004,
+};
+
+// Software Reset (0x2F, 8-bit)
+enum : u8 {
+    kResetAll             = 0x01,
+    kResetCommand         = 0x02,
+    kResetData            = 0x04,
+};
+
+// Interrupt Status (0x30, 32-bit)
+enum : u32 {
+    kIntCommandComplete   = 0x00000001,
+    kIntTransferComplete  = 0x00000002,
+    kIntBlockGap          = 0x00000004,
+    kIntDma               = 0x00000008,
+    kIntBufferWriteReady  = 0x00000010,
+    kIntBufferReadReady   = 0x00000020,
+    kIntCardInsertion     = 0x00000040,
+    kIntCardRemoval       = 0x00000080,
+    kIntCardInterrupt     = 0x00000100,
+    kIntError             = 0x00008000,
+    kErrCommandTimeout    = 0x00010000,
+    kErrCommandCrc        = 0x00020000,
+    kErrCommandEndBit     = 0x00040000,
+    kErrCommandIndex      = 0x00080000,
+    kErrDataTimeout       = 0x00100000,
+    kErrDataCrc           = 0x00200000,
+    kErrDataEndBit        = 0x00400000,
+    kErrCurrentLimit      = 0x00800000,
+    kErrAutoCmd12         = 0x01000000,
+    kErrAdma              = 0x02000000,
+};
+
+// Capabilities (0x40, 32-bit)
+enum : u32 {
+    kCapTimeoutClockMask  = 0x0000003F,
+    kCapBaseClockShift    = 8,
+    kCapBaseClockMask     = 0x000000FF,
+};
+
+// ADMA2 descriptor attributes (low 16 bits of the first descriptor word).
+enum : u16 {
+    kAdma2AttrValid       = 1u << 0,
+    kAdma2AttrEnd         = 1u << 1,
+    kAdma2AttrInt         = 1u << 2,
+    kAdma2AttrActNop      = 0u << 4,
+    kAdma2AttrActReserved = 1u << 4,
+    kAdma2AttrActTransfer = 2u << 4,
+    kAdma2AttrActLink     = 3u << 4,
+};
+
+// eMMC commands used by the bring-up path.
+enum : u8 {
+    kCmd0GoIdleState       = 0,
+    kCmd1SendOpCond        = 1,
+    kCmd2AllSendCid        = 2,
+    kCmd3SetRelativeAddr   = 3,
+    kCmd6Switch            = 6,
+    kCmd7SelectCard        = 7,
+    kCmd8SendExtCsd        = 8,
+    kCmd9SendCsd           = 9,
+    kCmd12StopTransmission = 12,
+    kCmd13SendStatus       = 13,
+    kCmd16SetBlockLength   = 16,
+    kCmd17ReadSingleBlock  = 17,
+    kCmd18ReadMultiple     = 18,
+    kCmd24WriteSingleBlock = 24,
+    kCmd25WriteMultiple    = 25,
+};
+
+} // namespace sdhci
+
+#endif // NATIVE_SDHCI_REGS_H
diff --git a/drivers/NativeSdhci/SdhciTypes.h b/drivers/NativeSdhci/SdhciTypes.h
new file mode 100644
index 0000000..217349a
--- /dev/null
+++ b/drivers/NativeSdhci/SdhciTypes.h
@@ -0,0 +1,28 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+//
+// Integer types for the eMMC driver.
+//
+// The core is compiled twice: into the kernel from the XNU headers, and on a
+// build host for the unit tests. Kernel builds do not guarantee a hosted
+// <stdint.h>, so the widths are spelled out here instead of pulled from a
+// library header.
+#ifndef NATIVE_SDHCI_TYPES_H
+#define NATIVE_SDHCI_TYPES_H
+
+namespace sdhci {
+
+typedef unsigned char      u8;
+typedef unsigned short     u16;
+typedef unsigned int       u32;
+typedef unsigned long long u64;
+
+// The driver assumes these widths; make a wrong target a compile error rather
+// than a silent misread of a register.
+static_assert(sizeof(u8) == 1, "u8 must be one byte");
+static_assert(sizeof(u16) == 2, "u16 must be two bytes");
+static_assert(sizeof(u32) == 4, "u32 must be four bytes");
+static_assert(sizeof(u64) == 8, "u64 must be eight bytes");
+
+} // namespace sdhci
+
+#endif // NATIVE_SDHCI_TYPES_H
