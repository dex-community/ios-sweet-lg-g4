diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 9fdd184..fc977f8 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -129,6 +129,9 @@
  * x9 and x10 are scratch here: nothing between the start of start_first_cpu
  * and the return to arm_init depends on them.
  */
+/* Diagnostic: the MMU alone, no caches. */
+#define SCTLR_EL1_M_ONLY	1
+
 #define SWEET_MARK_BASE		0x90003000
 #define SWEET_MARK_INFO		0x90003800
 
@@ -973,11 +976,49 @@ common_start:
 	MOV64   x0, SCTLR_EL1_DEFAULT
 
 #if defined(SWEET)
-	/* Marker 10: about to write SCTLR_EL1. If this appears without marker 3,
-	 * the write itself, or the first fetch after it, is what kills the CPU. */
+	/*
+	 * Marker 10: about to write SCTLR_EL1. If this appears without marker 3,
+	 * the write itself, or the first fetch after it, is what kills the CPU.
+	 * Along with it, the state that decides which MMU is in charge: the
+	 * exception level the kernel was entered at, the core, and the part
+	 * number. A kernel entered at EL2 does not enable its own translation
+	 * here at all; a kernel entered at EL1 does.
+	 */
 	SWEET_MARK SWEET_MARK_BASE + 0x240, 0x5EED000A
+	movz	x10, #((SWEET_MARK_INFO) & 0xffff)
+	movk	x10, #((((SWEET_MARK_INFO) >> 16)) & 0xffff), lsl #16
+	mrs		x11, CurrentEL
+	str		x11, [x10, #0x28]
+	mrs		x11, MPIDR_EL1
+	str		x11, [x10, #0x30]
+	mrs		x11, MIDR_EL1
+	str		x11, [x10, #0x38]
+	dc		civac, x10
+	dsb		sy
 #endif
 
+	/*
+	 * Diagnostic split of the switch: first the MMU alone (M=1, caches
+	 * still off), then the caches on top of it. On the G4 the kernel dies
+	 * with the full SCTLR_EL1_DEFAULT, and these two markers say whether it
+	 * is the translation itself (no 0x2c4) or the cache enable (0x2c4 but
+	 * no marker 3).
+	 */
+#if defined(SWEET)
+	/*
+	 * Marker 11: the MMU is about to be switched on, alone, with the
+	 * caches still off. If this marker is there and marker 12 is not, the
+	 * write of SCTLR_EL1 (or the isb right after it) is what kills the
+	 * CPU: the kernel does not even get to fault, the bus simply stops.
+	 */
+	SWEET_MARK SWEET_MARK_BASE + 0x2c0, 0x5EED000B
+	MOV64   x0, SCTLR_EL1_M_ONLY
+	MSR_SCTLR_EL1_X0
+	isb		sy
+	/* Marker 12: the MMU is on and the caches are still off. */
+	SWEET_MARK SWEET_MARK_BASE + 0x2c4, 0x5EED000C
+	MOV64   x0, SCTLR_EL1_DEFAULT
+#endif
 	MSR_SCTLR_EL1_X0
 	isb		sy
 
diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
index eda0626..4090bae 100644
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -26,6 +26,7 @@
 #include <stdint.h>
 #include <stddef.h>
 #include <kern/misc_protos.h>
+#include <vm/pmap.h>
 
 #define EARLY_LOG_SIZE 8192
 /* Cache line of the CPUs this runs on (Cortex-A53 and the sweet's A76/A55):
@@ -50,6 +51,35 @@ sweet_early_putc(char c)
 	sweet_early_buf[sweet_early_len] = '\0';
 }
 
+/*
+ * Write a boot marker.
+ *
+ * The assembly writes the marks of the early boot into a page of plain RAM
+ * at 0x90003000, cleaning the cache line after every word so it lands in
+ * DRAM whatever the cache state is. The recovery reads that page back after
+ * the watchdog reset, so a mark written from C has to be written the same
+ * way: same page, same clean. The page is above the kernel, in the upper
+ * DRAM bank, which the recovery does not reuse.
+ */
+#define SWEET_MARK_BASE_PA 0x90003000
+
+void
+sweet_mark(unsigned int off, uint32_t value)
+{
+	/*
+	 * The physical address is not a kernel virtual address: the markers
+	 * written by the assembly live in the bootstrap V=P map, which is gone
+	 * by now. From C the only way to reach that page is the physical map,
+	 * so the address is translated first.
+	 */
+	volatile uint32_t *p = (volatile uint32_t *)
+	    phystokv(SWEET_MARK_BASE_PA + off);
+
+	*p = value;
+	__asm__ volatile("dc civac, %0" :: "r"(p) : "memory");
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
 /*
  * Push the text out to memory.
  *
