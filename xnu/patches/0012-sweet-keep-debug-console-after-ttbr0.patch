diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index 95d9ea8..29c34f5 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -2158,15 +2158,21 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 
 	ml_enable_monitor();
 
-	/* The framebuffer VA=PA mapping belongs to the outgoing TTBR0. */
-	sweet_early_disable();
+	/*
+	 * The outgoing TTBR0 goes away here, but the early console is a buffer
+	 * in the BSS: the final TTBR1 maps it, so it keeps working. Do not
+	 * disable it, and mark the progress: from here on the kernel runs on
+	 * its own page tables, with the physical aperture remapped.
+	 */
 	set_mmu_ttb(invalid_ttep & TTBR_BADDR_MASK);
 
 	flush_mmu_tlb();
+	sweet_early_mark(10, "bootstrap TTBR0 off; TLB flushed");
 	kva_active = TRUE;
 	// global table pointers may need to be different due to physical aperture remapping
 	cpu_tte = (tt_entry_t*)(phystokv(cpu_ttep));
 	invalid_tte = (tt_entry_t*)(phystokv(invalid_ttep));
+	sweet_early_mark(11, "physmap table pointers rebound");
 
 	// From here on out, we're off the bootstrap translation tables.
 
@@ -2259,7 +2265,9 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
     }
 #endif
 #endif
+	sweet_early_mark(12, "calling pmap_bootstrap");
 	pmap_bootstrap(dynamic_memory_begin);
+	sweet_early_mark(13, "pmap_bootstrap done");
 
 	disable_preemption();
 
@@ -2310,6 +2318,7 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 		va_l1 = va_l2_end;
 		cpu_l1_tte++;
 	}
+	sweet_early_mark(14, "early I/O page tables ready");
 
 #if defined(KERNEL_INTEGRITY_KTRR) || defined(KERNEL_INTEGRITY_CTRR)
 	/*
