diff --git a/bsd/dev/sweet_emmc.c b/bsd/dev/sweet_emmc.c
new file mode 100644
index 0000000..bff62a8bc53217a9f17838f4db08b84441963102
--- /dev/null
+++ b/bsd/dev/sweet_emmc.c
@@ -0,0 +1,842 @@
+/*
+ * SWEET eMMC root device (read-only block device).
+ *
+ * The Qualcomm SDHCI host (MSM8992) is left enabled by the bootloader,
+ * which loaded our boot image from the eMMC. The shim that runs before XNU
+ * has already brought the host and the card up (core reset, legacy clock
+ * path, 400 kHz, CMD0..CMD16), but this driver does not rely on that: it
+ * re-identifies the card from CMD0, the way the working Linux driver and
+ * the UniXNU NativeSdhci driver do, and then serves the partition that
+ * holds the iOS root filesystem as a BSD block device.
+ *
+ * The register layout and the flag value of every command are the ones
+ * measured on the phone by the shim (shim/emmc.c). The command register is
+ * 16 bit at 0x0E, the command index goes into bits [15:8] and the low byte
+ * holds the length of the answer plus the checks. These are the values the
+ * card answered to on the real device:
+ *
+ *   CMD0   0x00  no answer
+ *   CMD1   0x02  48 bit (OCR), no CRC7, no index
+ *   CMD2   0x09  136 bit + CRC7, NO index check
+ *   CMD3   0x1a  48 bit + CRC7 + index
+ *   CMD7   0x0b  48 bit busy + CRC7
+ *   CMD16  0x0a  48 bit + CRC7
+ *   CMD17  0x3a  48 bit + CRC7 + index + data present
+ *
+ * CMD2 with the index check (0x19) is what the first version of the shim
+ * used and the card refused it: the answer came back as an error and the
+ * command line stayed busy. Without the index check (0x09) the CID comes
+ * back, which is what the working Linux driver programs too.
+ *
+ * The root filesystem is the HFS+ volume of the "ios" partition. The device
+ * that XNU gets is that partition, not the whole card: the volume header
+ * of an HFS+ volume sits at offset 1024 of its partition, so the device
+ * has to start exactly there.
+ *
+ * Root on eMMC with rd=emmc0. Reads only - writes are refused.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/buf.h>
+#include <sys/conf.h>
+#include <sys/disk.h>
+#include <sys/errno.h>
+#include <sys/proc.h>
+#include <sys/uio_internal.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/locks.h>
+#include <kern/clock.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <libkern/libkern.h>
+#include <arm/machine_routines.h>
+
+/*
+ * ml_io_map is declared by <arm/machine_routines.h> only under
+ * MACH_KERNEL_PRIVATE or PEXPERT_KERNEL_PRIVATE; the declaration is repeated
+ * here so the file does not depend on those.
+ */
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+/* Controller windows (MSM8992, LG G4 H815). */
+#define HC_BASE         0xf9824900ULL
+#define HC_SIZE         0x1a0
+#define CORE_BASE       0xf9824000ULL
+#define CORE_SIZE       0x800
+
+/* SDHCI registers. */
+#define HC_BLK_SIZE     0x04	/* 16 bit */
+#define HC_BLK_COUNT    0x06	/* 16 bit */
+#define HC_ARGUMENT     0x08	/* 32 bit */
+#define HC_TRANSFER     0x0c	/* 16 bit */
+#define HC_COMMAND      0x0e	/* 16 bit: index << 8 | flags */
+#define HC_RESPONSE     0x10	/* 32 bit x 4 (0x10..0x1c) */
+#define HC_BUF_PORT     0x20	/* 32 bit */
+#define HC_PRESENT      0x24	/* 32 bit */
+#define HC_CTRL1        0x28	/* 8 bit */
+#define HC_POWER        0x29	/* 8 bit */
+#define HC_CLK_CTRL     0x2c	/* 16 bit */
+#define HC_TIMEOUT      0x2e	/* 8 bit */
+#define HC_SWRST        0x2f	/* 8 bit */
+#define HC_INT_STATUS   0x30	/* 32 bit */
+#define HC_INT_ENABLE   0x34	/* 32 bit */
+#define HC_INT_SIGNAL   0x38	/* 32 bit */
+#define HC_HOST_CTRL2   0x3c	/* 16 bit */
+#define HC_CAPS1        0x40	/* 32 bit */
+#define HC_CAPS2        0x44	/* 32 bit */
+#define HC_VENDOR_SPEC  0x10c	/* 32 bit: the MSM clock path */
+
+/* MCI (core) registers. */
+#define CORE_POWER      0x00	/* 32 bit, bit 7 = core reset */
+#define CORE_HC_MODE    0x78	/* 32 bit, bit 0 = HC mode, bit 13 = FF_CLK_SW_RST_DIS */
+
+#define HC_MODE_EN        (1u << 0)
+#define FF_CLK_SW_RST_DIS (1u << 13)
+
+/* Present state (0x24). */
+#define PS_CMD_INHIBIT    0x00000001u
+#define PS_DATA_INHIBIT   0x00000002u
+#define PS_DATA_AVAILABLE 0x00000800u	/* buffer read enable */
+#define PS_DAT0_LEVEL     0x00100000u
+
+/* Interrupt status (0x30). */
+#define INT_CMD_DONE      0x00000001u
+#define INT_XFER_DONE     0x00000002u
+#define INT_ERR_MASK      0xffff8000u	/* error summary and the error half */
+
+/* Command register flags (the low byte of HC_COMMAND). */
+#define CMD_RESP_NONE      0x00
+#define CMD_RESP_136       0x01
+#define CMD_RESP_48        0x02
+#define CMD_RESP_48_BUSY   0x03
+#define CMD_CRC_CHECK      0x08
+#define CMD_INDEX_CHECK    0x10
+#define CMD_DATA_PRESENT   0x20
+
+/* The flag sets the card answered to, measured on the phone. */
+#define CFG_CMD0    CMD_RESP_NONE
+#define CFG_CMD1    CMD_RESP_48			/* OCR: 48 bit, no CRC7, no index */
+#define CFG_CMD2    (CMD_RESP_136 | CMD_CRC_CHECK)	/* CID: 136 bit + CRC7 */
+#define CFG_CMD3    (CMD_RESP_48 | CMD_CRC_CHECK | CMD_INDEX_CHECK)
+#define CFG_CMD7    (CMD_RESP_48_BUSY | CMD_CRC_CHECK)
+#define CFG_CMD16   (CMD_RESP_48 | CMD_CRC_CHECK)
+#define CFG_CMD17   (CMD_RESP_48 | CMD_CRC_CHECK | CMD_INDEX_CHECK | CMD_DATA_PRESENT)
+
+/* Transfer mode (0x0c). */
+#define MODE_READ          0x0010
+
+/* Card status (R1): the state is bits 12:9, READY_FOR_DATA is bit 8. */
+#define R1_STATE(r)        (((r) >> 9) & 0xfu)
+#define CARD_STATE_TRAN    4u
+/* The errors that make an answer unusable. */
+#define R1_FATAL           0xe4180000u
+
+/* MMC commands. */
+#define CMD_GO_IDLE         0
+#define CMD_SEND_OP_COND    1
+#define CMD_ALL_SEND_CID    2
+#define CMD_SET_REL_ADDR    3
+#define CMD_SELECT_CARD     7
+#define CMD_SET_BLOCKLEN   16
+#define CMD_READ_SINGLE    17
+
+/* The card is high capacity: the argument of CMD17 is the block number. */
+#define OCR_VALUE           0x40ff8000u
+#define OCR_BUSY            0x80000000u
+#define OCR_POWER_UP        0x40000000u
+
+/* Timeouts, in microseconds of polling. */
+#define EMMC_CMD_TIMEOUT    500000
+#define EMMC_XFER_TIMEOUT   2000000
+#define EMMC_FIFO_TIMEOUT   100000
+
+/* The relative card address the host assigns with CMD3. The factory LK
+ * assigns 2 on this phone and the card has answered to it at every boot. */
+#define EMMC_RCA            2u
+
+/*
+ * The partition that holds the iOS root filesystem, measured on the phone
+ * when the volume was written (the HFS+ volume header is at offset 1024 of
+ * it). It is only used when the GPT cannot be read; the partition is found
+ * by name and by its HFS+ signature first.
+ */
+#define EMMC_FALLBACK_FIRST_LBA  12419072ULL
+#define EMMC_FALLBACK_BLOCKS     48627712ULL
+
+/* GPT layout (UEFI 2.10). */
+#define GPT_SIGNATURE       "EFI PART"
+#define GPT_HEADER_LBA      1ULL
+#define GPT_ENTRY_ARRAY_LBA 2ULL
+#define GPT_ENTRY_SECTORS   32
+#define GPT_NAME_OFFSET     56
+#define GPT_FIRST_LBA_OFF   32
+#define GPT_LAST_LBA_OFF    40
+
+static vm_address_t hc_base;
+static vm_address_t core_base;
+
+static uint32_t emmc_last_int_status;	/* the interrupt status of a failure */
+static uint32_t emmc_rca = EMMC_RCA;
+
+/* The geometry of the partition that is served. */
+static uint64_t emmc_part_first;	/* first LBA on the card */
+static uint64_t emmc_part_blocks;	/* size in 512 byte blocks */
+
+static int emmc_initialized;
+static int emmc_major = -1;
+static void *emmc_node;
+/* lck_mtx_t is opaque on arm64: the mutex is allocated. */
+static lck_mtx_t *emmc_lock;
+
+static inline uint32_t rd32(uintptr_t a) { return *(volatile uint32_t *)a; }
+static inline void     wr32(uintptr_t a, uint32_t v) { *(volatile uint32_t *)a = v; }
+static inline uint16_t rd16(uintptr_t a) { return *(volatile uint16_t *)a; }
+static inline void     wr16(uintptr_t a, uint16_t v) { *(volatile uint16_t *)a = v; }
+static inline uint8_t  rd8(uintptr_t a)  { return *(volatile uint8_t *)a; }
+static inline void     wr8(uintptr_t a, uint8_t v) { *(volatile uint8_t *)a = v; }
+
+static uint32_t le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8) |
+	    ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+static uint64_t le64(const uint8_t *p)
+{
+	return (uint64_t)le32(p) | ((uint64_t)le32(p + 4) << 32);
+}
+
+/*
+ * Wait for one of the wanted interrupt bits. Returns the status, or 0 on
+ * timeout. A status that carries an error bit is returned as well: the
+ * caller tells the two apart with INT_ERR_MASK.
+ */
+static uint32_t emmc_wait_status(uint32_t wanted, uint32_t timeout_us)
+{
+	uint32_t i;
+
+	for (i = 0; i < timeout_us; i++) {
+		uint32_t status = rd32(hc_base + HC_INT_STATUS);
+
+		if (status & INT_ERR_MASK)
+			return status;
+		if (status & wanted)
+			return status;
+		delay(1);
+	}
+	return 0;
+}
+
+/* Wait until the command and the data lines are free. */
+static int emmc_wait_idle(void)
+{
+	uint32_t i;
+
+	for (i = 0; i < EMMC_CMD_TIMEOUT; i++) {
+		if (!(rd32(hc_base + HC_PRESENT) & (PS_CMD_INHIBIT | PS_DATA_INHIBIT)))
+			return 0;
+		delay(1);
+	}
+	return -1;
+}
+
+/*
+ * The card holds DAT0 low while it is busy. If the host does not show the
+ * line level, fall back to a fixed delay that is longer than a 512 byte
+ * program.
+ */
+static void emmc_wait_busy(void)
+{
+	uint32_t i;
+
+	for (i = 0; i < 3000000; i++) {
+		if (rd32(hc_base + HC_PRESENT) & PS_DAT0_LEVEL)
+			return;
+		delay(1);
+	}
+}
+
+/*
+ * One command without a data phase. The flags are the low byte of the
+ * command register, already assembled.
+ */
+static int emmc_cmd(uint8_t index, uint32_t arg, uint16_t flags, uint32_t *rsp)
+{
+	uint32_t status;
+
+	if (emmc_wait_idle())
+		return -1;
+
+	/* Acknowledge every status bit before the command goes out. */
+	wr32(hc_base + HC_INT_STATUS, 0xffffffffu);
+
+	wr32(hc_base + HC_ARGUMENT, arg);
+	wr16(hc_base + HC_TRANSFER, 0);
+	wr16(hc_base + HC_COMMAND, (uint16_t)(((uint16_t)index << 8) | flags));
+
+	status = emmc_wait_status(INT_CMD_DONE, EMMC_CMD_TIMEOUT);
+	if (!status)
+		return -2;
+	if (status & INT_ERR_MASK) {
+		emmc_last_int_status = status;
+		return -3;
+	}
+	if (rsp)
+		*rsp = rd32(hc_base + HC_RESPONSE);
+	wr32(hc_base + HC_INT_STATUS, INT_CMD_DONE);
+
+	/* A 48 bit "busy" answer is sent when the card is ready. */
+	if ((flags & 0x03u) == CMD_RESP_48_BUSY)
+		emmc_wait_busy();
+
+	return 0;
+}
+
+/*
+ * One block of 512 bytes, read with CMD17 (READ_SINGLE_BLOCK) through the
+ * FIFO, no DMA. Exactly like the shim does it on the phone.
+ */
+static int emmc_read_sector(uint32_t lba, uint8_t *dst)
+{
+	volatile uint32_t *fifo = (volatile uint32_t *)(hc_base + HC_BUF_PORT);
+	uint32_t status, r1;
+	int i;
+
+	if (emmc_wait_idle())
+		return -1;
+
+	wr16(hc_base + HC_BLK_SIZE, 0x0200);	/* 512 bytes */
+	wr16(hc_base + HC_BLK_COUNT, 1);
+	wr16(hc_base + HC_TRANSFER, MODE_READ);
+	wr32(hc_base + HC_INT_STATUS, 0xffffffffu);
+	wr32(hc_base + HC_ARGUMENT, lba);
+	wr16(hc_base + HC_COMMAND,
+	    (uint16_t)(((uint16_t)CMD_READ_SINGLE << 8) | CFG_CMD17));
+
+	status = emmc_wait_status(INT_CMD_DONE, EMMC_CMD_TIMEOUT);
+	if (!status)
+		return -2;
+	if (status & INT_ERR_MASK) {
+		emmc_last_int_status = status;
+		return -3;
+	}
+	r1 = rd32(hc_base + HC_RESPONSE);
+	wr32(hc_base + HC_INT_STATUS, INT_CMD_DONE);
+	if (r1 & R1_FATAL)
+		return -4;
+
+	for (i = 0; i < 128; i++) {
+		uint32_t v;
+		uint32_t spins = 0;
+
+		while (!(rd32(hc_base + HC_PRESENT) & PS_DATA_AVAILABLE)) {
+			uint32_t st = rd32(hc_base + HC_INT_STATUS);
+
+			if (st & INT_ERR_MASK) {
+				emmc_last_int_status = st;
+				return -5;
+			}
+			if (++spins > EMMC_FIFO_TIMEOUT)
+				return -6;
+			delay(1);
+		}
+		/* Every read of the buffer port pops four bytes. */
+		v = fifo[0];
+		dst[i * 4 + 0] = (uint8_t)v;
+		dst[i * 4 + 1] = (uint8_t)(v >> 8);
+		dst[i * 4 + 2] = (uint8_t)(v >> 16);
+		dst[i * 4 + 3] = (uint8_t)(v >> 24);
+	}
+
+	status = emmc_wait_status(INT_XFER_DONE, EMMC_XFER_TIMEOUT);
+	if (!status)
+		return -7;
+	if (status & INT_ERR_MASK) {
+		emmc_last_int_status = status;
+		return -8;
+	}
+	wr32(hc_base + HC_INT_STATUS, INT_XFER_DONE);
+
+	return 0;
+}
+
+/*
+ * The clock of the card, in divided clock mode with a 10 bit divider, the
+ * way the LK does it (0x0f912ec4). The base clock comes from the
+ * capabilities register.
+ */
+static int emmc_set_clock(uint32_t base_hz, uint32_t target_hz)
+{
+	uint32_t clk;
+	uint32_t i;
+
+	if (base_hz <= target_hz) {
+		clk = 1;
+	} else {
+		uint32_t d = 2, n;
+
+		for (; d < 0x7fe; d += 2)
+			if (target_hz >= base_hz / d)
+				break;
+		if (d >= 0x7fe)
+			return -1;
+		n = d >> 1;
+		clk = ((n & 0xffu) << 8) | (((n >> 8) & 3u) << 6) | 1u;
+	}
+
+	wr16(hc_base + HC_CLK_CTRL, (uint16_t)clk);
+	for (i = 0; i < 200; i++) {
+		if (rd16(hc_base + HC_CLK_CTRL) & 2u)
+			break;
+		delay(100);
+	}
+	if (!(rd16(hc_base + HC_CLK_CTRL) & 2u))
+		return -2;
+	/* The SD clock comes out of the divider. */
+	wr16(hc_base + HC_CLK_CTRL, (uint16_t)(clk | 4u));
+	return 0;
+}
+
+/*
+ * The clock path of the MCI. The LK leaves the controller on the HS400
+ * path (MCLK_SEL = 3, the CDC input on HS400) and then puts the card to
+ * sleep; in that state the identification clock never reaches the card.
+ * The working Linux driver puts both back to the default before it talks
+ * to a card that is not in HS400, and so does this driver.
+ */
+static void emmc_legacy_clock_path(void)
+{
+	uint32_t vs = rd32(hc_base + HC_VENDOR_SPEC);
+
+	vs = (vs & ~(3u << 8)) | (2u << 8);	/* MCLK_SEL = free running MCLK */
+	vs &= ~(1u << 18);			/* SELECT_IN_EN off */
+	vs &= ~(7u << 19);			/* SELECT_IN = default */
+	vs &= ~(1u << 1);			/* CLK_PWRSAVE off: no self gating */
+	wr32(hc_base + HC_VENDOR_SPEC, vs);
+}
+
+/*
+ * The card identification: CMD0, CMD1 until the OCR says the card is up,
+ * CMD2 for the CID, CMD3 for the address, CMD7 to select it and CMD16 for
+ * the block length. The flag values are the ones measured on the phone.
+ */
+static int emmc_identify(void)
+{
+	uint32_t rsp = 0, cid[4];
+	uint32_t i;
+
+	/* CMD0: the card goes back to the idle state. */
+	if (emmc_cmd(CMD_GO_IDLE, 0, CFG_CMD0, NULL)) {
+		printf("emmc: CMD0 failed\n");
+		return -1;
+	}
+	delay(1000);
+
+	/* CMD1: the card powers up and answers with its OCR. */
+	for (i = 0; i < 1000; i++) {
+		if (emmc_cmd(CMD_SEND_OP_COND, OCR_VALUE, CFG_CMD1, &rsp)) {
+			printf("emmc: CMD1 failed\n");
+			return -1;
+		}
+		if (rsp & OCR_BUSY)
+			break;
+		delay(1000);
+	}
+	if (i >= 1000) {
+		printf("emmc: CMD1 never completed\n");
+		return -1;
+	}
+
+	/*
+	 * CMD2: the CID, a 136 bit answer. The card refuses this command
+	 * when the index check is asked for, so the flags are the ones that
+	 * worked on the phone (136 bit + CRC7).
+	 */
+	if (emmc_cmd(CMD_ALL_SEND_CID, 0, CFG_CMD2, cid)) {
+		printf("emmc: CMD2 failed (int=0x%x)\n", emmc_last_int_status);
+		return -1;
+	}
+	printf("emmc: CID %08x %08x %08x %08x\n",
+	    cid[0], cid[1], cid[2], cid[3]);
+
+	/* CMD3: the host gives the card its relative address. */
+	if (emmc_cmd(CMD_SET_REL_ADDR, emmc_rca << 16, CFG_CMD3, &rsp)) {
+		printf("emmc: CMD3 failed\n");
+		return -1;
+	}
+
+	/* CMD7: the card is selected and goes to the transfer state. */
+	if (emmc_cmd(CMD_SELECT_CARD, emmc_rca << 16, CFG_CMD7, &rsp)) {
+		printf("emmc: CMD7 failed\n");
+		return -1;
+	}
+
+	/* CMD16: the block length, 512 bytes. */
+	if (emmc_cmd(CMD_SET_BLOCKLEN, 512, CFG_CMD16, &rsp)) {
+		printf("emmc: CMD16 failed\n");
+		return -1;
+	}
+	if (R1_STATE(rsp) != CARD_STATE_TRAN) {
+		printf("emmc: the card is not in the transfer state (R1=0x%08x)\n", rsp);
+		return -1;
+	}
+
+	return 0;
+}
+
+/* Does the sector hold the signature of an HFS+ volume header? */
+static int emmc_is_hfs_header(const uint8_t *sector)
+{
+	if (sector[0] != 'H' || sector[1] != 'X')
+		return 0;
+	if (sector[2] != 0 || sector[3] != 5)
+		return 0;
+	return 1;
+}
+
+/* The name of a GPT entry is UTF-16LE. */
+static int emmc_gpt_name_is(const uint8_t *entry, const char *ascii)
+{
+	int i;
+
+	for (i = 0; ascii[i] != '\0'; i++) {
+		if (entry[GPT_NAME_OFFSET + i * 2] != (uint8_t)ascii[i])
+			return 0;
+		if (entry[GPT_NAME_OFFSET + i * 2 + 1] != 0)
+			return 0;
+	}
+	return 1;
+}
+
+/*
+ * The partition that holds the iOS root filesystem. The GPT is read from
+ * the card, and the partition is the one named "ios"; a partition is
+ * accepted when its offset 1024 holds the signature of an HFS+ volume
+ * header, so the answer does not depend on the name alone.
+ */
+static int emmc_find_partition(void)
+{
+	uint8_t sector[512];
+	uint8_t header[512];
+	uint64_t entries_lba;
+	uint32_t num_entries, entry_size;
+	uint32_t sec, e;
+	int have_by_name = 0;
+	uint64_t by_name_first = 0, by_name_blocks = 0;
+
+	if (emmc_read_sector((uint32_t)GPT_HEADER_LBA, header))
+		return -1;
+	if (memcmp(header, GPT_SIGNATURE, 8) != 0) {
+		printf("emmc: no GPT signature at LBA %llu\n",
+		    (unsigned long long)GPT_HEADER_LBA);
+		return -1;
+	}
+
+	entries_lba = le64(&header[72]);
+	num_entries = le32(&header[80]);
+	entry_size = le32(&header[84]);
+	if (entries_lba < GPT_ENTRY_ARRAY_LBA || entries_lba > 64) {
+		printf("emmc: the GPT points to a bad entry array (LBA %llu)\n",
+		    (unsigned long long)entries_lba);
+		return -1;
+	}
+	if (num_entries == 0 || num_entries > 512 || entry_size < 128 ||
+	    entry_size > 512) {
+		printf("emmc: the GPT entry geometry is wrong (%u x %u)\n",
+		    num_entries, entry_size);
+		return -1;
+	}
+
+	for (sec = 0; sec < GPT_ENTRY_SECTORS; sec++) {
+		uint32_t per_sector = 512 / entry_size;
+
+		if (emmc_read_sector((uint32_t)(entries_lba + sec), sector))
+			return -1;
+
+		for (e = 0; e < per_sector; e++) {
+			const uint8_t *entry = &sector[e * entry_size];
+			uint64_t first, last;
+			uint8_t probe[512];
+
+			if (sec * per_sector + e >= num_entries)
+				break;
+			first = le64(&entry[GPT_FIRST_LBA_OFF]);
+			last = le64(&entry[GPT_LAST_LBA_OFF]);
+			if (last <= first)
+				continue;
+
+			/* The volume header of an HFS+ volume is at 1024. */
+			if (emmc_read_sector((uint32_t)(first + 2), probe))
+				continue;
+			if (!emmc_is_hfs_header(probe))
+				continue;
+
+			if (emmc_gpt_name_is(entry, "ios")) {
+				emmc_part_first = first;
+				emmc_part_blocks = last - first + 1;
+				printf("emmc: the ios partition is LBA %llu..%llu\n",
+				    (unsigned long long)first,
+				    (unsigned long long)last);
+				return 0;
+			}
+			if (!have_by_name) {
+				have_by_name = 1;
+				by_name_first = first;
+				by_name_blocks = last - first + 1;
+			}
+		}
+	}
+
+	if (have_by_name) {
+		emmc_part_first = by_name_first;
+		emmc_part_blocks = by_name_blocks;
+		printf("emmc: the partition with the HFS+ volume is LBA %llu..%llu\n",
+		    (unsigned long long)by_name_first,
+		    (unsigned long long)(by_name_first + by_name_blocks - 1));
+		return 0;
+	}
+
+	/*
+	 * No GPT, or no partition with a volume in it: fall back to the
+	 * partition the volume was written to, but only if the signature is
+	 * really there.
+	 */
+	if (emmc_read_sector((uint32_t)(EMMC_FALLBACK_FIRST_LBA + 2), sector))
+		return -1;
+	if (!emmc_is_hfs_header(sector)) {
+		printf("emmc: no HFS+ volume found on the card\n");
+		return -1;
+	}
+	emmc_part_first = EMMC_FALLBACK_FIRST_LBA;
+	emmc_part_blocks = EMMC_FALLBACK_BLOCKS;
+	printf("emmc: falling back to LBA %llu for the root filesystem\n",
+	    (unsigned long long)EMMC_FALLBACK_FIRST_LBA);
+	return 0;
+}
+
+static int emmc_init(void)
+{
+	uint32_t caps, base_mhz;
+	int rc;
+
+	printf("emmc: initializing...\n");
+
+	hc_base = (vm_address_t)ml_io_map(HC_BASE, HC_SIZE);
+	if (!hc_base) {
+		printf("emmc: failed to map the host registers\n");
+		return -1;
+	}
+	core_base = (vm_address_t)ml_io_map(CORE_BASE, CORE_SIZE);
+	if (!core_base) {
+		printf("emmc: failed to map the core registers\n");
+		return -1;
+	}
+
+	/*
+	 * The LK switches the HC mode off before it jumps to the kernel.
+	 * The reverse operation is not only "set the bit again": it clears
+	 * the bit, pulses the core reset, waits a millisecond, writes the
+	 * register and sets FF_CLK_SW_RST_DIS. The core reset is what
+	 * re-synchronises the SDHCI side with the card. It resets the MCI,
+	 * not the host controller, so the CDC and the DLL calibration that
+	 * the LK set up are left alone.
+	 */
+	if (!(rd32(core_base + CORE_HC_MODE) & HC_MODE_EN)) {
+		wr32(core_base + CORE_HC_MODE,
+		    rd32(core_base + CORE_HC_MODE) & ~HC_MODE_EN);
+		wr32(core_base + CORE_POWER, rd32(core_base + CORE_POWER) | (1u << 7));
+		delay(1000);
+		wr32(core_base + CORE_HC_MODE, HC_MODE_EN);
+		wr32(core_base + CORE_HC_MODE,
+		    rd32(core_base + CORE_HC_MODE) | FF_CLK_SW_RST_DIS);
+	}
+
+	caps = rd32(hc_base + HC_CAPS1);
+	if (caps == 0 || caps == 0xffffffffu) {
+		printf("emmc: the capability register reads 0x%x\n", caps);
+		return -1;
+	}
+	base_mhz = (caps >> 8) & 0xffu;
+	if (base_mhz == 0)
+		base_mhz = 200;
+	printf("emmc: base clock %u MHz\n", base_mhz);
+
+	/* The status bits that are polled have to be latched. */
+	wr32(hc_base + HC_INT_ENABLE,
+	    rd32(hc_base + HC_INT_ENABLE) | 0x03ff00ffu);
+	/* No interrupt is raised: everything is polled. */
+	wr32(hc_base + HC_INT_SIGNAL, 0);
+
+	/* The bus power comes up at 3.3 V, the way the LK does it. */
+	wr8(hc_base + HC_POWER, 0x0f);
+	/* One bit, legacy speed. */
+	wr8(hc_base + HC_CTRL1, rd8(hc_base + HC_CTRL1) & ~0x26u);
+	wr8(hc_base + HC_TIMEOUT, 0x0f);
+
+	emmc_legacy_clock_path();
+
+	/* The identification wants the 400 kHz clock. */
+	rc = emmc_set_clock(base_mhz * 1000000u, 400000);
+	if (rc) {
+		printf("emmc: cannot set the 400 kHz clock (%d)\n", rc);
+		return -1;
+	}
+
+	if (emmc_identify())
+		return -1;
+
+	/*
+	 * The card is identified and in the transfer state. Now it can run
+	 * at 25 MHz, which is the fastest the legacy timing allows on one
+	 * bit. At 400 kHz the 128 MB catalog of the volume would take three
+	 * quarters of an hour.
+	 */
+	rc = emmc_set_clock(base_mhz * 1000000u, 25000000);
+	if (rc)
+		printf("emmc: the 25 MHz clock failed (%d), staying at 400 kHz\n", rc);
+	else
+		printf("emmc: the card runs at 25 MHz\n");
+
+	if (emmc_find_partition())
+		return -1;
+
+	emmc_initialized = 1;
+	return 0;
+}
+
+/*
+ * The block device interface. The root of XNU is a block device: the file
+ * system reads it through the buffer cache, which calls the strategy
+ * function with the block number and the byte count of the request.
+ */
+static int emmc_open(dev_t dev, int flags, int fmt, proc_t p)
+{
+	if (!emmc_initialized) {
+		if (emmc_init())
+			return ENXIO;
+	}
+	return 0;
+}
+
+static int emmc_close(dev_t dev, int flags, int fmt, proc_t p)
+{
+	return 0;
+}
+
+static int emmc_size(dev_t dev)
+{
+	return 512;
+}
+
+static int emmc_ioctl(dev_t dev, u_long cmd, caddr_t data, int flag, proc_t p)
+{
+	switch (cmd) {
+	case DKIOCGETBLOCKSIZE:
+		*((uint32_t *)data) = 512;
+		return 0;
+	case DKIOCGETBLOCKCOUNT:
+		*((uint64_t *)data) = emmc_part_blocks;
+		return 0;
+	default:
+		return ENOTTY;
+	}
+}
+
+static void emmc_strategy(struct buf *bp)
+{
+	caddr_t vaddr = NULL;
+	uint32_t count = buf_count(bp);
+	uint64_t lba = buf_blkno(bp);
+	uint32_t off;
+	int error = 0;
+
+	if (!(buf_flags(bp) & B_READ)) {
+		/* The medium is read only. */
+		buf_seterror(bp, EROFS);
+		buf_biodone(bp);
+		return;
+	}
+
+	if (buf_map(bp, &vaddr)) {
+		buf_seterror(bp, EIO);
+		buf_biodone(bp);
+		return;
+	}
+
+	lck_mtx_lock(emmc_lock);
+	for (off = 0; off < count; off += 512) {
+		uint64_t block = lba + off / 512;
+
+		if (emmc_part_blocks && block >= emmc_part_blocks) {
+			error = EINVAL;
+			break;
+		}
+		if (emmc_read_sector((uint32_t)(emmc_part_first + block),
+		    (uint8_t *)vaddr + off)) {
+			printf("emmc: the read of LBA %llu failed (int=0x%x)\n",
+			    (unsigned long long)(emmc_part_first + block),
+			    emmc_last_int_status);
+			error = EIO;
+			break;
+		}
+	}
+	lck_mtx_unlock(emmc_lock);
+
+	buf_unmap(bp);
+
+	if (error)
+		buf_seterror(bp, error);
+	else
+		buf_setresid(bp, 0);
+	buf_biodone(bp);
+}
+
+static const struct bdevsw emmc_bdevsw = {
+	.d_open     = emmc_open,
+	.d_close    = emmc_close,
+	.d_strategy = emmc_strategy,
+	.d_ioctl    = emmc_ioctl,
+	.d_dump     = eno_dump,
+	.d_psize    = emmc_size,
+	.d_type     = D_DISK,
+};
+
+/* Called from IOKitBSDInit for rd=emmc0. */
+int sweet_emmc_rootdev(dev_t *dev)
+{
+	if (!emmc_initialized) {
+		if (emmc_init())
+			return ENXIO;
+	}
+
+	if (emmc_major < 0) {
+		emmc_major = bdevsw_add(-1, &emmc_bdevsw);
+		if (emmc_major < 0) {
+			printf("emmc: no major number for the block device\n");
+			return ENXIO;
+		}
+	}
+	if (emmc_lock == NULL) {
+		lck_mtx_alloc_init(&emmc_lock, NULL, NULL);
+		if (emmc_lock == NULL) {
+			printf("emmc: the mutex could not be allocated\n");
+			return ENXIO;
+		}
+	}
+
+	if (emmc_node == NULL) {
+		emmc_node = devfs_make_node(makedev(emmc_major, 0), DEVFS_BLOCK,
+		    UID_ROOT, GID_OPERATOR, 0660, "emmc0");
+		if (emmc_node == NULL) {
+			printf("emmc: the device node could not be created\n");
+			return ENXIO;
+		}
+	}
+
+	*dev = makedev(emmc_major, 0);
+	return 0;
+}
+
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/drivers/NativeSdhci/BoardConstants.h b/drivers/NativeSdhci/BoardConstants.h
new file mode 100644
index 0000000..6f828e3
--- /dev/null
+++ b/drivers/NativeSdhci/BoardConstants.h
@@ -0,0 +1,94 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+//
+// Lumia 950 (MSM8992, Snapdragon 808) board constants for the eMMC path.
+//
+// Source for every value below: the mainline MSM8992 device tree, which is
+// msm8994.dtsi with two A57 cores removed. Node `sdhc1`, alias `mmc1`:
+//
+//   mmc@f9824900 {
+//       compatible = "qcom,msm8994-sdhci", "qcom,sdhci-msm-v4";
+//       reg = <0xf9824900 0x1a0>, <0xf9824000 0x800>;
+//       reg-names = "hc", "core";
+//       interrupts = <GIC_SPI 123 IRQ_TYPE_LEVEL_HIGH>,
+//                    <GIC_SPI 138 IRQ_TYPE_LEVEL_HIGH>;
+//       interrupt-names = "hc_irq", "pwr_irq";
+//       clocks = <&gcc GCC_SDCC1_AHB_CLK>, <&gcc GCC_SDCC1_APPS_CLK>, <&xo_board>;
+//       bus-width = <8>;
+//       non-removable;
+//   };
+//
+// These are the SoC's addresses for the controller, not proof of what the Lumia
+// firmware programmed. Confirm them on hardware against the firmware's own
+// SDCC driver and the ACPI tables copied from the stock FFU before trusting a
+// read failure as a driver bug. See README.md, "Proving the map".
+#ifndef NATIVE_SDHCI_BOARD_CONSTANTS_H
+#define NATIVE_SDHCI_BOARD_CONSTANTS_H
+
+#include "SdhciTypes.h"
+
+namespace lumia950 {
+
+// SDHCI host registers, the "hc" region of the device tree node.
+constexpr sdhci::u64 kSdhciHcPhys   = 0xf9824900ULL;
+constexpr sdhci::u32 kSdhciHcSize   = 0x1a0;
+
+// Qualcomm QSDCC vendor window, the "core" region. The DLL and power-control
+// registers needed for HS200/HS400 live here; this driver does not touch them
+// yet, so the window is mapped only for diagnostics.
+constexpr sdhci::u64 kSdhciCorePhys = 0xf9824000ULL;
+constexpr sdhci::u32 kSdhciCoreSize = 0x800;
+
+// GICv2 interrupts from the node. The Lumia 950's controller is a
+// "qcom,msm-qgic2" at 0xf9000000/0xf9002000, not a GICv3 with redistributors.
+constexpr sdhci::u32 kIrqHc           = 123;
+constexpr sdhci::u32 kIrqPower        = 138;
+
+// Card clock source: XO is 19.2 MHz and GCC supplies SDCC1, but the firmware
+// leaves the controller clocked and the card selected. The first bring-up rung
+// therefore never reprograms the clock; it measures what is there instead.
+constexpr sdhci::u32 kXoHz = 19200000;
+
+// Logical block size reported to IOBlockStorageDriver. eMMC logical sectors are
+// 512 bytes; transfers are performed in 512-byte blocks for now.
+constexpr sdhci::u32 kLogicalBlockBytes = 512;
+
+// Global clock controller (msm8994 "qcom,gcc" at 0xfc400000). Only SDCC1's root clock
+// generator and branch are touched, with the register layout and frequency plan of the
+// cityman kernel's clock-gcc-8994.c: CMD_RCGR 0x4d0 (CFG +4, M +8, N +0xc, D +0x10),
+// APPS_CBCR 0x4c4, AHB_CBCR 0x4c8. Sources: 0 is XO, 1 is GPLL0 (600 MHz).
+constexpr sdhci::u64 kGccPhys = 0xfc400000ULL;
+constexpr sdhci::u32 kGccSize = 0x1000;
+constexpr sdhci::u32 kGccSdcc1AppsCbcr = 0x4c4;
+constexpr sdhci::u32 kGccSdcc1AhbCbcr = 0x4c8;
+constexpr sdhci::u32 kGccSdcc1AppsCmdRcgr = 0x4d0;
+
+// The firmware's card does not answer after ExitBootServices (CMD13 times out at every
+// RCA), so the driver identifies it again and assigns this address.
+constexpr sdhci::u16 kColdRelativeAddress = 2;
+
+// Legacy (backward-compatible) eMMC timing tops out at 26 MHz; 25 MHz is the plan's
+// GPLL0 / 12 * 1/2 entry. HS and HS200 come later with CMD6 and the DLL.
+constexpr sdhci::u32 kTransferHz = 25000000;
+// High-speed SDR on the 8-bit bus once EXT_CSD offers it: GPLL0 / 12, the plan's 50 MHz entry.
+constexpr sdhci::u32 kHighSpeedHz = 50000000;
+
+// The one partition the write path may touch: p55, carved out of userdata for the iOS root. Writes
+// also need boot-arg sdhcirw=1; without both the medium reports itself write protected.
+constexpr char kWritablePartition[] = "ios";
+
+// The console log: a header block and this many ring blocks at the very end of the writable
+// partition, used only when they lie past the end of the HFS+ volume that starts it.
+constexpr sdhci::u32 kConsoleLogBlocks = 65536;   // 32 MiB of text
+
+// eMMC relative card address. The firmware assigned one and selected the card;
+// these are the values EDK2 and Linux hosts normally use, tried in order.
+constexpr sdhci::u16 kRcaCandidates[] = { 1, 2 };
+
+// The GPT header sits in LBA 1 with the signature "EFI PART". Reading it is the
+// cheapest end-to-end proof that the command path works on real silicon.
+constexpr sdhci::u64 kGptHeaderLba = 1;
+constexpr char kGptSignature[8] = { 'E', 'F', 'I', ' ', 'P', 'A', 'R', 'T' };
+
+} // namespace lumia950
+
+#endif // NATIVE_SDHCI_BOARD_CONSTANTS_H
