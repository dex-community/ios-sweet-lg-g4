diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
new file mode 100644
index 0000000..381fef82ee8acf768e735b93b6066ec2b08dc81b
--- /dev/null
+++ b/osfmk/arm64/sweet_early.c
@@ -0,0 +1,94 @@
+/*
+ * SWEET early console: a text buffer in the BSS.
+ *
+ * The first version of this drew the text on the "framebuffer" of the sweet
+ * board (0x9c000000), with a Normal-NC mapping made by hand in the
+ * bootstrap page tables. On the G4 that address is not a framebuffer at all
+ * but plain RAM (the bank at 0x80000000-0xdfffffff), and nothing was ever
+ * written there: the early console stayed silent, and the kernel died
+ * before anybody could see where.
+ *
+ * A buffer in the BSS works on every board:
+ *   - the marks are all written from C, so the MMU is on and the BSS is
+ *     mapped (it is zeroed at boot, so it starts empty);
+ *   - it cannot fault, and it needs no page table surgery in the assembly
+ *     that runs with the MMU still off;
+ *   - it is read back out of the RAM with the symbol table, the same way
+ *     the log of the eMMC driver is:
+ *
+ *       pa = va - virt_base + phys_base
+ *
+ *     tools/read-xnu-early.py does that.
+ */
+#include <arm64/sweet_early.h>
+
+#if defined(SWEET)
+#include <stdint.h>
+#include <kern/misc_protos.h>
+
+#define EARLY_LOG_SIZE 8192
+
+/* The text, and how much of it there is. Both are in the BSS. */
+char sweet_early_buf[EARLY_LOG_SIZE];
+uint32_t sweet_early_len;
+
+static uint32_t early_disabled;
+static uint32_t early_panicking;
+
+void
+sweet_early_putc(char c)
+{
+	if (early_disabled)
+		return;
+	if (sweet_early_len >= EARLY_LOG_SIZE - 1)
+		return;
+	sweet_early_buf[sweet_early_len++] = c;
+	sweet_early_buf[sweet_early_len] = '\0';
+}
+
+static void
+sweet_early_string(const char *s)
+{
+	while (*s) {
+		sweet_early_putc(*s++);
+	}
+}
+
+void
+sweet_early_mark(unsigned int stage, const char *label)
+{
+	if (early_disabled || stage > 8) {
+		return;
+	}
+	sweet_early_string("SWEET EARLY ");
+	sweet_early_putc((char)('0' + stage));
+	sweet_early_string(": ");
+	sweet_early_string(label);
+	sweet_early_putc('\n');
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+void
+sweet_early_panic(const char *fmt, va_list *args)
+{
+	if (early_disabled || early_panicking) {
+		return;
+	}
+	early_panicking = 1;
+	sweet_early_string("\nSWEET EARLY PANIC: ");
+	va_list copy;
+	va_copy(copy, *args);
+	_doprnt(fmt, &copy, sweet_early_putc, 16);
+	va_end(copy);
+	sweet_early_putc('\n');
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+void
+sweet_early_disable(void)
+{
+	sweet_early_mark(8, "leaving bootstrap TTBR0");
+	early_disabled = 1;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+#endif /* SWEET */
diff --git a/osfmk/arm64/sweet_early.h b/osfmk/arm64/sweet_early.h
new file mode 100644
index 0000000..fbbc827
--- /dev/null
+++ b/osfmk/arm64/sweet_early.h
@@ -0,0 +1,22 @@
+/* Early screen diagnostics, valid only while the bootstrap TTBR0 is live. */
+#ifndef _ARM64_SWEET_EARLY_H_
+#define _ARM64_SWEET_EARLY_H_
+
+#include <pexpert/arm64/board_config.h>
+#include <stdarg.h>
+
+#if defined(SWEET)
+void sweet_early_mark(unsigned int stage, const char *label);
+void sweet_early_putc(char c);
+void sweet_early_panic(const char *fmt, va_list *args);
+void sweet_early_disable(void);
+#else
+static inline void sweet_early_mark(unsigned int stage, const char *label)
+{
+	(void)stage;
+	(void)label;
+}
+static inline void sweet_early_disable(void) {}
+#endif
+
+#endif
